                                                    contentItem: Item {}
                                                    indicator: Rectangle {
                                                        width: plan3.width
                                                        height: plan3.height
                                                        border.width: 1
                                                        radius: width / 2
                                                        color: "#ffffff"
                                                        border.color: plan3.checked ? "#3b6fe0" : "#767676"
                                                        antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                                        Rectangle {
                                                            anchors.centerIn: parent
                                                            width: parent.width * 0.6
                                                            height: width
                                                            radius: width / 2
                                                            color: "#3b6fe0"
                                                            visible: plan3.checked
                                                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                                        }
                                                    }
                                                    ButtonGroup.group: planGroup
                                                    Accessible.name: "Team"
                                                    Layout.fillWidth: true
                                                    Layout.maximumWidth: Math.ceil(implicitWidth)
                                                    Layout.alignment: Qt.AlignVCenter
                                                }

                                                Text {
                                                    text: "Team"
                                                    textFormat: Text.PlainText
                                                    color: "#1d2433"
                                                    font.family: "sans-serif"
                                                    font.pixelSize: 15
                                                    lineHeight: 21
                                                    lineHeightMode: Text.FixedHeight
                                                    transform: Translate {
                                                        y: 2
                                                    }
                                                    wrapMode: Text.WordWrap
                                                    Layout.fillWidth: true
                                                    Layout.maximumWidth: Math.ceil(implicitWidth)
                                                    Layout.alignment: Qt.AlignVCenter
                                                    Layout.leftMargin: 6
                                                    renderType: Text.NativeRendering
                                                }

                                                Item {
                                                    Layout.fillWidth: true
                                                }

                                                TapHandler {
                                                    onTapped: (eventPoint, button) => {
                                                        if (plan3.enabled) { plan3.click(); }
                                                    }
                                                }
                                            }

                                            Item {
                                                Layout.fillWidth: true
                                            }
                                        }
                                    }
                                }

                                // <div class="row">
                                GridLayout {
                                    columns: 2
                                    columnSpacing: 14
                                    rowSpacing: 14
                                    Layout.fillWidth: true
                                    Layout.maximumWidth: Number.POSITIVE_INFINITY
                                    Layout.fillHeight: true
                                    Layout.maximumHeight: Number.POSITIVE_INFINITY

                                    // <div class="field">
                                    ColumnLayout {
                                        spacing: 0
                                        Layout.fillWidth: true
                                        Layout.preferredWidth: 0
                                        Layout.maximumWidth: Number.POSITIVE_INFINITY
                                        Layout.fillHeight: true
                                        Layout.maximumHeight: Number.POSITIVE_INFINITY

                                        // <label class="field__label">
                                        Text {
                                            id: fieldLabel6
                                            property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                            text: "Seats"
                                            textFormat: Text.PlainText
                                            color: "#1d2433"
                                            font.family: "sans-serif"
                                            font.pixelSize: 14
                                            font.weight: 600
                                            lineHeight: 19.6
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 1
                                            }
                                            wrapMode: Text.WordWrap
                                            Layout.fillWidth: true
                                            renderType: Text.NativeRendering

                                            TapHandler {
                                                onTapped: (eventPoint, button) => {
                                                    if (seats.enabled) { seats.forceActiveFocus(); }
                                                }
                                            }
                                        }

                                        // <input id="seats" class="input">
                                        SpinBox {
                                            id: seats
                                            property string name: "seats"

                                            from: 1
                                            to: 10
                                            value: 2
                                            editable: true
                                            font.family: "sans-serif"
                                            font.pixelSize: 15
                                            background: Rectangle {
                                                color: "#ffffff"
                                                radius: 8
                                                border.width: 1
                                                border.color: seats.activeFocus ? "#3b6fe0" : "#cfd6e4"
                                                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                                RectangularShadow {
                                                    anchors.fill: parent
                                                    z: -1
                                                    offset: Qt.vector2d(0, 0)
                                                    blur: 0
                                                    color: seats.activeFocus ? "#333b6fe0" : "#00000000"
                                                    radius: 8
                                                    spread: seats.activeFocus ? 3 : 0
                                                }
                                            }
                                            topPadding: 10
                                            rightPadding: 13
                                            bottomPadding: 10
                                            leftPadding: 13
                                            implicitHeight: 41
                                            implicitWidth: 191
                                            up.indicator.visible: false
                                            up.indicator.width: 0
                                            up.indicator.height: 0
                                            down.indicator.visible: false
                                            down.indicator.width: 0
                                            down.indicator.height: 0
                                            contentItem: TextInput {
                                                text: seats.displayText
                                                font: seats.font
                                                color: "#1d2433"
                                                verticalAlignment: Qt.AlignVCenter
                                                readOnly: !seats.editable
                                                validator: seats.validator
                                                inputMethodHints: Qt.ImhFormattedNumbersOnly
                                                renderType: Text.NativeRendering
                                            }
                                            Accessible.name: "Seats"
                                            Layout.preferredWidth: parent.width
                                            Layout.alignment: Qt.AlignLeft
                                            Layout.topMargin: 5 - fieldLabel6.eldurCarry
                                        }

                                        Item {
                                            Layout.fillHeight: true
                                        }
                                    }

                                    // <div class="field">
                                    ColumnLayout {
                                        spacing: 0
                                        Layout.fillWidth: true
                                        Layout.preferredWidth: 0
                                        Layout.maximumWidth: Number.POSITIVE_INFINITY
                                        Layout.fillHeight: true
                                        Layout.maximumHeight: Number.POSITIVE_INFINITY

                                        // <label class="field__label">
                                        Text {
                                            id: fieldLabel7
                                            property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                            text: "Notification volume"
                                            textFormat: Text.PlainText
                                            color: "#1d2433"
                                            font.family: "sans-serif"
                                            font.pixelSize: 14
                                            font.weight: 600
                                            lineHeight: 19.6
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 1
                                            }
                                            wrapMode: Text.WordWrap
                                            Layout.fillWidth: true
                                            renderType: Text.NativeRendering

                                            TapHandler {
                                                onTapped: (eventPoint, button) => {
                                                    if (volume.enabled) { volume.forceActiveFocus(); }
                                                }
                                            }
                                        }

                                        // <input id="volume">
                                        Slider {
                                            id: volume
                                            property string name: "volume"
                                            property real eldurCarry: Math.ceil(Layout.topMargin + 16) - Layout.topMargin - 16 + 0.000001

                                            from: 0
                                            to: 100
                                            stepSize: 1
                                            snapMode: Slider.SnapAlways
                                            value: 40
                                            implicitWidth: 129
                                            implicitHeight: 16
                                            padding: 0
                                            background: Rectangle {
                                                y: (volume.height - height) / 2
                                                width: volume.width
                                                height: 8
                                                radius: 4
                                                color: "#efefef"
                                                border.color: "#767676"
                                                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                                Rectangle {
                                                    width: volume.visualPosition * parent.width
                                                    height: parent.height
                                                    radius: 4
                                                    color: "#0075ff"
                                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                                }
                                            }
                                            handle: Rectangle {
                                                x: volume.visualPosition * (volume.width - width)
                                                y: (volume.height - height) / 2
                                                width: 16
                                                height: 16
                                                radius: 8
                                                color: "#0075ff"
                                                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                            }
                                            Accessible.name: "Notification volume"
                                            Layout.fillWidth: true
                                            Layout.topMargin: 5 - fieldLabel7.eldurCarry
                                        }

                                        // <p class="hint">
                                        Text {
                                            text: "Adjust how often we email you."
                                            textFormat: Text.PlainText
                                            color: "#5b6478"
                                            font.family: "sans-serif"
                                            font.pixelSize: 12
                                            lineHeight: 16.8
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 1
                                            }
                                            wrapMode: Text.WordWrap
                                            Layout.fillWidth: true
                                            Layout.topMargin: 4 - volume.eldurCarry
                                            Layout.preferredHeight: implicitHeight
                                            renderType: Text.NativeRendering
                                        }

                                        Item {
                                            Layout.fillHeight: true
                                        }
                                    }
                                }

                                // <label class="check">
                                RowLayout {
                                    spacing: 0
                                    Layout.fillWidth: true
                                    Layout.maximumWidth: Number.POSITIVE_INFINITY
                                    Layout.fillHeight: true
                                    Layout.maximumHeight: Number.POSITIVE_INFINITY

                                    // <input>
                                    CheckBox {
                                        id: terms
                                        property string value: "on"
                                        property string name: "terms"

                                        implicitWidth: 13
                                        implicitHeight: 13
                                        padding: 0
                                        spacing: 0
                                        contentItem: Item {}
                                        indicator: Rectangle {
                                            width: terms.width
                                            height: terms.height
                                            border.width: 1
                                            radius: 2
                                            color: terms.checked ? "#3b6fe0" : "#ffffff"
                                            border.color: terms.checked ? "#3b6fe0" : "#767676"
                                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                            Text {
                                                anchors.centerIn: parent
                                                text: "✓"
                                                color: "#ffffff"
                                                font.pixelSize: Math.max(1, terms.height - 2)
                                                visible: terms.checked
                                                renderType: Text.NativeRendering
                                            }
                                        }
                                        Accessible.name: "I agree to the terms of service"
                                        Layout.fillWidth: true
                                        Layout.preferredWidth: 16
                                        Layout.maximumWidth: 16
                                        Layout.preferredHeight: 16
                                        Layout.alignment: Qt.AlignVCenter
                                    }

                                    Text {
                                        text: "I agree to the terms of service"
                                        textFormat: Text.PlainText
                                        color: "#1d2433"
                                        font.family: "sans-serif"
                                        font.pixelSize: 14
                                        lineHeight: 19.6
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 1
                                        }
                                        wrapMode: Text.WordWrap
                                        Layout.fillWidth: true
                                        Layout.maximumWidth: Math.ceil(implicitWidth)
                                        Layout.alignment: Qt.AlignVCenter
                                        Layout.leftMargin: 8
                                        renderType: Text.NativeRendering
                                    }

                                    Item {
                                        Layout.fillWidth: true
                                    }

                                    TapHandler {
                                        onTapped: (eventPoint, button) => {
                                            if (terms.enabled) { terms.click(); }
                                        }
                                    }
                                }

                                // <div class="actions">
                                RowLayout {
                                    spacing: 0
                                    Layout.fillWidth: true
                                    Layout.maximumWidth: Number.POSITIVE_INFINITY
                                    Layout.fillHeight: true
                                    Layout.maximumHeight: Number.POSITIVE_INFINITY
                                    Layout.topMargin: 6

                                    Item {
                                        Layout.fillWidth: true
                                    }

                                    // <button class="btn btn--secondary">
                                    Button {
                                        id: buttonControl
                                        text: "Reset"
                                        palette.buttonText: "#1d2433"
                                        font.family: "sans-serif"
                                        font.pixelSize: 15
                                        font.weight: 600
                                        background: Rectangle {
                                            color: buttonControl.hovered ? "#f5f7fb" : "#ffffff"
                                            radius: 8
                                            border.width: 1
                                            border.color: "#cfd6e4"
                                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                        }
                                        topPadding: 11
                                        rightPadding: 19
                                        bottomPadding: 11
                                        leftPadding: 19
                                        implicitHeight: 43
                                        contentItem: Text {
                                            text: buttonControl.text
                                            font: buttonControl.font
                                            color: buttonControl.palette.buttonText
                                            horizontalAlignment: Text.AlignHCenter
                                            verticalAlignment: Text.AlignVCenter
                                            renderType: Text.NativeRendering
                                        }
                                        Layout.fillWidth: true
                                        Layout.maximumWidth: Math.ceil(implicitWidth)
                                        Layout.fillHeight: true
                                        hoverEnabled: true

                                        onClicked: {
                                            name.text = "";
                                            email.text = "";
                                            password.text = "";
                                            team.currentIndex = 1;
                                            bio.text = "";
                                            plan.checked = true;
                                            plan2.checked = false;
                                            plan3.checked = false;
                                            seats.value = 2;
                                            volume.value = 40;
                                            terms.checked = false;
                                        }
                                    }

                                    // <button class="btn btn--primary">
                                    Button {
                                        id: buttonControl2
                                        text: "Create account"
                                        palette.buttonText: "#ffffff"
                                        font.family: "sans-serif"
                                        font.pixelSize: 15
                                        font.weight: 600
                                        background: Rectangle {
                                            color: buttonControl2.hovered ? "#2d5bc4" : "#3b6fe0"
                                            radius: 8
                                            border.width: 1
                                            border.color: "#00000000"
                                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                        }
                                        topPadding: 11
                                        rightPadding: 19
                                        bottomPadding: 11
                                        leftPadding: 19
                                        implicitHeight: 43
                                        contentItem: Text {
                                            text: buttonControl2.text
