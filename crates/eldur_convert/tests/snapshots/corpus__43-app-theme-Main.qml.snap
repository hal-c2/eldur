    property var eldurLiteralClasses: ["compact"]
    property bool eldurOpenElements: true
    property string eldurControlFonts: "[{\"names\":[\"serif\",\"Times\",\"Times New Roman\",\"Georgia\",\"Liberation Serif\"],\"small\":[0.555,1.2],\"large\":[0.555,1.28],\"gap\":0.042},{\"names\":[\"monospace\"],\"small\":[0.6,2.4],\"large\":[0.6,2.5],\"gap\":0},{\"names\":[\"Helvetica\"],\"small\":[0.555,0.075],\"large\":[0.555,0.03],\"gap\":0.033},{\"names\":[],\"small\":[0.6,1.275],\"large\":[0.582,1.28],\"gap\":0.033}]"
    readonly property var eldurInitialBlock: initialContainingBlock

    visible: true
    color: "#ffffff"
    title: "Theme"
    width: 1280
    height: 800

    function tableExtents(grid, specs) {
        const n = specs.length
        const edges = grid.tableEdges || []
        const shift = b => edges[b] || 0
        const min = new Array(n).fill(0)
        const max = new Array(n).fill(0)
        const spanning = []
        // Rows a script added are not in the grid; the runtime says what their cells need.
        const cells = Array.from(grid.children).concat(grid.eldurCreatedCells || [])
        for (let i = 0; i < cells.length; ++i) {
            const cell = cells[i]
            const slot = cell.tableSlot
            if (!slot || cell.visible === false)
                continue
            const more = shift(slot[1] + slot[3]) - shift(slot[1])
            const need = { slot: slot, min: cell.minContentWidth + more, max: cell.implicitWidth + more }
            if (slot[3] > 1) {
                spanning.push(need)
                continue
            }
            min[slot[1]] = Math.max(min[slot[1]], need.min)
            max[slot[1]] = Math.max(max[slot[1]], need.max)
        }
        for (const cell of spanning) {
            const first = cell.slot[1]
            const last = first + cell.slot[3]
            const gaps = grid.columnSpacing * (cell.slot[3] - 1)
            for (const [widths, wanted] of [[min, cell.min], [max, cell.max]]) {
                let have = 0
                let weight = 0
                for (let c = first; c < last; ++c) {
                    have += widths[c]
                    weight += max[c]
                }
                const missing = wanted - gaps - have
                if (missing <= 0)
                    continue
                const add = []
                for (let c = first; c < last; ++c)
                    add.push(weight > 0 ? missing * max[c] / weight : missing / cell.slot[3])
                for (let c = first; c < last; ++c)
                    widths[c] += add[c - first]
            }
        }
        for (let c = 0; c < n; ++c) {
            max[c] = Math.max(max[c], min[c])
            if (typeof specs[c] === "number")
                max[c] = Math.max(max[c], specs[c])
        }
        // Percentages count up to 100% in all, in column order.
        const percents = []
        let total = 0
        for (let c = 0; c < n; ++c) {
            const p = typeof specs[c] === "string" ? Math.max(0, Math.min(parseFloat(specs[c]), 100 - total)) : 0
            percents.push(p)
            total += p
        }
        // What our cells have past the browser's: its outer border halves.
        const outside = shift(0) - shift(n)
        // A column whose content is one word cannot wrap; a word's overhang past its
        // advance is under a pixel, a space and a letter more.
        const wraps = max.map((m, c) => m - min[c] > 1)
        return { min: min, max: max, percents: percents, shift: shift, outside: outside, wraps: wraps }
    }

    function tableMaxContentWidth(grid, specs, fixed) {
        let sum = grid.columnSpacing * (specs.length - 1)
        if (fixed) {
            for (let c = 0; c < specs.length; ++c)
                sum += typeof specs[c] === "number" ? specs[c] : 0
            return sum
        }
        const extents = root.tableExtents(grid, specs)
        let all = 0
        let rest = 0
        let percent = 0
        let wanted = 0
        for (let c = 0; c < specs.length; ++c) {
            all += extents.max[c]
            if (typeof specs[c] !== "string")
                rest += extents.max[c]
            else if (extents.percents[c] > 0)
                wanted = Math.max(wanted, extents.max[c] * 100 / extents.percents[c])
            percent += extents.percents[c]
        }
        if (percent > 0 && percent < 100)
            wanted = Math.max(wanted, rest * 100 / (100 - percent))
        // Columns come out whole pixels, those at max-content that can wrap rounded up.
        let whole = 0
        for (let c = 0; c < specs.length; ++c) {
            const drawn = extents.max[c] + extents.shift(c) - extents.shift(c + 1)
            whole += extents.wraps[c] ? Math.ceil(drawn - 1e-6) : drawn
        }
        return sum + Math.max(Math.max(all, wanted) + extents.outside, whole)
    }

    function tableMinContentWidth(grid, specs, fixed) {
        let sum = grid.columnSpacing * (specs.length - 1)
        if (fixed) {
            for (let c = 0; c < specs.length; ++c)
                sum += typeof specs[c] === "number" ? specs[c] : 0
            return sum
        }
        const extents = root.tableExtents(grid, specs)
        for (let c = 0; c < specs.length; ++c)
            sum += extents.min[c]
        return sum + extents.outside
    }

    function tableColumnWidths(grid, specs, fixed) {
        const n = specs.length
        if (n === 0)
            return []
        const extents = fixed ? null : root.tableExtents(grid, specs)
        const shift = fixed ? (b => 0) : extents.shift
        const space = Math.max(0, grid.width - grid.columnSpacing * (n - 1) - (fixed ? 0 : extents.outside))
        const px = c => typeof specs[c] === "number"
        const pc = c => typeof specs[c] === "string"
        let widths
        if (fixed) {
            // Specified widths stand; the rest is shared equally, there being no
            // content widths to weigh.
            widths = specs.map((s, c) => px(c) ? s : pc(c) ? parseFloat(s) * space / 100 : 0)
            const left = space - widths.reduce((a, b) => a + b, 0)
            const auto = specs.map((s, c) => !px(c) && !pc(c))
            for (const takes of [auto, specs.map((s, c) => px(c)), specs.map((s, c) => pc(c))]) {
                const sum = widths.reduce((a, w, c) => a + (takes[c] ? w : 0), 0)
                const count = takes.filter(t => t).length
                if (left <= 0 || count === 0)
                    continue
                const equal = takes === auto || sum <= 0
                widths = widths.map((w, c) => takes[c] ? w + left * (equal ? 1 / count : w / sum) : w)
                break
            }
        } else {
            const min = extents.min
            const share = c => Math.max(min[c], extents.percents[c] * space / 100)
            const guesses = [
                min.slice(),
                min.map((m, c) => pc(c) ? share(c) : m),
                min.map((m, c) => pc(c) ? share(c) : px(c) ? extents.max[c] : m),
                min.map((m, c) => pc(c) ? share(c) : extents.max[c])
            ]
            const sums = guesses.map(g => g.reduce((a, b) => a + b, 0))
            widths = guesses[0]
            for (let g = 1; g < guesses.length; ++g) {
                if (space >= sums[g]) {
                    widths = guesses[g]
                    continue
                }
                if (space > sums[g - 1]) {
                    const t = (space - sums[g - 1]) / (sums[g] - sums[g - 1])
                    widths = guesses[g].map((w, c) => guesses[g - 1][c] + (w - guesses[g - 1][c]) * t)
                }
                break
            }
            const excess = space - sums[guesses.length - 1]
            if (excess > 0) {
                widths = widths.slice()
                const auto = c => !px(c) && !pc(c)
                const takers = [
                    c => auto(c) && extents.max[c] > 0 ? extents.max[c] : 0,
                    c => px(c) ? Math.max(widths[c], 1e-9) : 0,
                    c => pc(c) && extents.percents[c] > 0 ? extents.percents[c] : 0,
                    c => 1
                ]
                for (const weigh of takers) {
                    const weights = widths.map((w, c) => weigh(c))
                    const total = weights.reduce((a, b) => a + b, 0)
                    if (total <= 0)
                        continue
                    for (let c = 0; c < n; ++c)
                        widths[c] += excess * weights[c] / total
                    break
                }
            }
        }
        let edge = shift(0)
        let from = 0
        for (let c = 0; c < n; ++c) {
            edge += widths[c]
            let to = Math.round(edge - shift(c + 1))
            // A text wraps in a column a fraction narrower than it: one given its
            // max-content width keeps all of it, rounded up.
            if (!fixed && extents.wraps[c] && widths[c] >= extents.max[c] - 1e-6)
                to = Math.max(to, from + Math.ceil(extents.max[c] + shift(c) - shift(c + 1) - 1e-6))
            widths[c] = to - from
            from = to
        }
        return widths
    }

    function tableRowHeights(grid, minimums) {
        const heights = minimums.slice()
        const spanning = []
        for (let i = 0; i < grid.children.length; ++i) {
            const cell = grid.children[i]
            const slot = cell.tableSlot
            if (!slot)
                continue
            if (slot[2] > 1)
                spanning.push(cell)
            else
                heights[slot[0]] = Math.max(heights[slot[0]], cell.implicitHeight)
        }
        for (const cell of spanning) {
            const first = cell.tableSlot[0]
            const span = cell.tableSlot[2]
            let have = grid.rowSpacing * (span - 1)
            for (let r = first; r < first + span; ++r)
                have += heights[r]
            if (cell.implicitHeight > have) {
                for (let r = first; r < first + span; ++r)
                    heights[r] += (cell.implicitHeight - have) / span
            }
        }
        let edge = 0
        for (let r = 0; r < heights.length; ++r) {
            const next = edge + heights[r]
            heights[r] = Math.round(next) - Math.round(edge)
            edge = next
        }
        return heights
    }

    function scrollToFragment(eldurLink) {
        let eldurName = eldurLink.slice(1);
        const eldurTargets = Object.assign(Object.create(null), {
            "card": card,
            "compact": compact,
            "toggle": toggle
        });
        flickableInput.forceActiveFocus();
        Eldur.fragmentFollowed(eldurLink);
        if (!(eldurName in eldurTargets)) {
            try {
                eldurName = decodeURIComponent(eldurName);
            } catch (e) {
                eldurName = null;
            }
        }
        const eldurTarget = eldurName === null ? undefined : eldurTargets[eldurName];
        if (eldurTarget) {
            for (let eldurAt = eldurTarget.parent; eldurAt && eldurAt !== flickable; eldurAt = eldurAt.parent) {
                if (eldurAt instanceof Flickable)
                    eldurAt.contentY = Math.max(0, Math.min(eldurTarget.mapToItem(eldurAt.contentItem, 0, 0).y, eldurAt.contentHeight - eldurAt.height));
            }
            const eldurY = eldurTarget.mapToItem(flickable.contentItem, 0, 0).y;
            flickable.contentY = Math.max(0, Math.min(eldurY, flickable.contentHeight - flickable.height));
        } else if (eldurName !== null && (eldurName === "" || eldurName.toLowerCase() === "top")) {
            flickable.contentY = 0;
        }
    }

    Component.onCompleted: {
        Page.__eldur_init(root);
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: Math.max(page.implicitHeight, initialContainingBlock.childrenRect.y + initialContainingBlock.childrenRect.height)

        EldurScrollInput {
            id: flickableInput
            scroller: flickable
            keySource: flickable.parent
            focus: true
        }

        // <html>
        ColumnLayout {
            id: page
            property var eldurAttrs: ({ "lang": "en", "data-theme": "light" })
            property string eldurTag: "html"

            spacing: 0
            width: flickable.width

            // <body>
            ColumnLayout {
                property string eldurTag: "body"
                property string eldurWs: "\n"
                property string eldurWsEnd: "\n\n\n"

                spacing: 0
                Layout.fillWidth: true
                Layout.maximumWidth: Number.POSITIVE_INFINITY
                Layout.bottomMargin: 24

                // <div class="top">
                Rectangle {
                    property string eldurTag: "div"
                    property string eldurClasses: "top"
                    property string eldurWs: "\n"
                    property string eldurWsEnd: "\n"

                    color: "#00000000"
                    implicitWidth: topContent.implicitWidth + 48
                    implicitHeight: topContent.implicitHeight + 33
                    Layout.fillWidth: true

                    Rectangle {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.bottom: parent.bottom
                        height: 1
                        color: "#e2e8f0"
                    }

                    RowLayout {
                        id: topContent
                        spacing: 0
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        anchors.bottom: parent.bottom
                        anchors.leftMargin: 24
                        anchors.rightMargin: 24
                        anchors.topMargin: 16
                        anchors.bottomMargin: 17

                        // <div class="title">
                        Text {
                            property string eldurTag: "div"
                            property string eldurClasses: "title"
                            property string eldurWs: "\n  "

                            text: "Journal"
                            textFormat: Text.PlainText
                            color: "#1a202c"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 20
                            font.weight: 700
                            lineHeight: 30
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: EldurFonts.shift("Arial, sans-serif", 20, 700, false, 30)
                            }
                            bottomPadding: EldurFonts.slack(font, lineHeight)
                            wrapMode: Text.WordWrap
                            Layout.fillWidth: true
                            Layout.maximumWidth: Math.ceil(implicitWidth)
                            Layout.alignment: Qt.AlignVCenter
                            renderType: Text.NativeRendering
                        }

                        Item {
                            Layout.fillWidth: true
                        }

                        // <div>
                        EldurLines {
                            id: divFlow
                            property string eldurTag: "div"
                            property string eldurWs: "\n  "
                            property string eldurWsEnd: "\n  "

                            color: "#1a202c"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 16
                            lineHeight: 24
                            Layout.fillWidth: true
                            Layout.maximumWidth: Math.ceil(implicitWidth)
                            Layout.alignment: Qt.AlignVCenter

                            // <button id="compact">
                            Button {
                                id: compact
                                property string eldurTag: "button"
                                property string eldurWs: "\n    "

                                text: "Compact"
                                palette.buttonText: "#1a202c"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 13
                                background: Rectangle {
                                    color: "#f7fafc"
                                    radius: 4
                                    border.width: 1
                                    border.color: "#e2e8f0"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 7
                                rightPadding: 13
                                bottomPadding: 7
                                leftPadding: 13
                                implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                                contentItem: Text {
                                    text: compact.text
                                    font: compact.font
                                    color: compact.palette.buttonText
                                    horizontalAlignment: Text.AlignHCenter
                                    verticalAlignment: Text.AlignVCenter
                                    wrapMode: Text.WordWrap
                                    renderType: Text.NativeRendering
                                }
                                implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                objectName: "compact"
                                width: Math.min(implicitWidth, Math.max(divFlow.width, Math.ceil(Math.max(...compact.text.split(/\s+/).map(w => compactWords.advanceWidth(w))) * 1.0256385) + leftPadding + rightPadding))

                                onClicked: {
                                    Page.__eldur_on_click_compact(Eldur.event("click", compact, null));
                                }

                                FontMetrics {
                                    id: compactWords
                                    font: compact.font
                                }
                            }

                            EldurRun {
                                text: " "
                                color: "#1a202c"
                                font.family: "Arial, sans-serif"
                                font.pixelSize: 16
                            }

                            // <button id="toggle">
                            Button {
                                id: toggle
                                property string eldurTag: "button"
                                property string eldurWs: "\n    "

                                text: "Dark mode"
                                palette.buttonText: "#1a202c"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 13
                                background: Rectangle {
                                    color: "#f7fafc"
                                    radius: 4
                                    border.width: 1
                                    border.color: "#e2e8f0"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 7
                                rightPadding: 13
                                bottomPadding: 7
                                leftPadding: 13
                                implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                                contentItem: Text {
                                    text: toggle.text
                                    font: toggle.font
                                    color: toggle.palette.buttonText
                                    horizontalAlignment: Text.AlignHCenter
                                    verticalAlignment: Text.AlignVCenter
                                    wrapMode: Text.WordWrap
                                    renderType: Text.NativeRendering
                                }
                                implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                objectName: "toggle"
                                width: Math.min(implicitWidth, Math.max(divFlow.width, Math.ceil(Math.max(...toggle.text.split(/\s+/).map(w => toggleWords.advanceWidth(w))) * 1.0256385) + leftPadding + rightPadding))

                                onClicked: {
                                    Page.__eldur_on_click_toggle(Eldur.event("click", toggle, null));
                                }

                                FontMetrics {
                                    id: toggleWords
                                    font: toggle.font
                                }
                            }
                        }
                    }
                }

                // <div id="card" class="card">
                Rectangle {
                    id: card
                    property string eldurTag: "div"
                    property string eldurClasses: "card"
                    property string eldurWs: "\n"
                    property string eldurWsEnd: "\n"

                    color: "#f7fafc"
                    radius: 8
                    implicitWidth: cardContent.implicitWidth + 42
                    implicitHeight: cardContent.implicitHeight + 42
                    border.width: 1
                    border.color: "#e2e8f0"
                    objectName: "card"
                    Layout.fillWidth: true
                    Layout.leftMargin: 24
                    Layout.rightMargin: 24
                    Layout.topMargin: 24
                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                    ColumnLayout {
                        id: cardContent
                        spacing: 0
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        anchors.leftMargin: 21
                        anchors.rightMargin: 21
                        anchors.topMargin: 21

                        // <h2>
                        Text {
                            property string eldurTag: "h2"
                            property string eldurWs: "\n  "

                            text: "Today"
                            textFormat: Text.PlainText
                            color: "#1a202c"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 18
                            font.weight: 700
                            lineHeight: 27
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: EldurFonts.shift("Arial, sans-serif", 18, 700, false, 27)
                            }
                            bottomPadding: EldurFonts.slack(font, lineHeight)
                            wrapMode: Text.WordWrap
                            Layout.fillWidth: true
                            renderType: Text.NativeRendering
                        }

                        // <p>
                        Text {
                            property string eldurTag: "p"
                            readonly property string eldurInline: "{\"bare\":false,\"hoisted\":false,\"html\":false,\"k\":{\"bg\":\"rgba(0, 0, 0, 0)\",\"color\":\"rgb(26, 32, 44)\",\"display\":\"block\",\"family\":\"Arial, sans-serif\",\"italic\":false,\"kw\":3,\"lf\":1.5,\"lh\":24.0,\"size\":16.0,\"strike\":false,\"underline\":false,\"us\":16.0,\"visible\":true,\"weight\":400},\"kids\":[{\"text\":\"Nothing much happened. \"},{\"attrs\":[[\"href\",\"#more\"],[\"id\",\"more\"]],\"c\":{\"bg\":\"rgba(0, 0, 0, 0)\",\"color\":\"rgb(43, 108, 176)\",\"display\":\"inline\",\"family\":\"Arial, sans-serif\",\"italic\":false,\"kw\":3,\"lf\":1.5,\"lh\":24.0,\"size\":16.0,\"strike\":false,\"underline\":true,\"us\":16.0,\"visible\":true,\"weight\":400},\"kids\":[{\"text\":\"Read more\"}],\"tag\":\"a\"},{\"text\":\" if you must.\"}],\"lh\":24.0,\"pre\":false,\"strike\":false,\"underline\":false}"
                            property string eldurWs: "\n  "

                            text: "Nothing much happened. <a href=\"#more\">Read more</a> if you must."
                            textFormat: Text.StyledText
                            color: "#1a202c"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 16
                            lineHeight: 24
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: EldurFonts.shift("Arial, sans-serif", 16, 400, false, 24)
                            }
                            bottomPadding: EldurFonts.slack(font, lineHeight)
                            wrapMode: Text.WordWrap
                            linkColor: "#2b6cb0"
                            Layout.fillWidth: true
                            Layout.topMargin: 8
                            renderType: Text.NativeRendering

                            onLinkActivated: (link) => {
                                Eldur.afterClick(function () {
                                if (link.startsWith("#"))
                                    root.scrollToFragment(link);
                                else
                                    Qt.openUrlExternally(link);
                                });
                            }

                            HoverHandler {
                                cursorShape: parent.linkAt(point.position.x, point.position.y) !== "" ? Qt.PointingHandCursor : Qt.ArrowCursor
                            }
                        }
                    }
                }
            }
        }

        Item {
            id: initialContainingBlock
            width: flickable.width
            height: flickable.height
        }
    }
}
