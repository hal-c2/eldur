                            property string eldurTag: "div"

                            Layout.fillWidth: true
                            Layout.preferredWidth: Math.ceil(Array.from(children).reduce((sum, item) => sum + item.implicitWidth, 0))
                            Layout.maximumWidth: Math.ceil(Array.from(children).reduce((sum, item) => sum + item.implicitWidth, 0))
                            Layout.alignment: Qt.AlignVCenter

                            Button {
                                id: compact
                                property string eldurTag: "button"

                                text: "Compact"
                                palette.buttonText: "#1a202c"
                                font.family: "sans-serif"
                                font.pixelSize: 13
                                background: Rectangle {
                                    color: "#f7fafc"
                                    radius: 4
                                    border.width: 1
                                    border.color: "#e2e8f0"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 7
                                rightPadding: 13
                                bottomPadding: 7
                                leftPadding: 13
                                contentItem: Text {
