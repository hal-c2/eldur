    property var eldurLiteralClasses: ["compact"]
    property bool eldurOpenElements: true
    readonly property var eldurInitialBlock: initialContainingBlock

    visible: true
    color: "#ffffff"
    title: "Theme"
    width: 1280
    height: 800

    function scrollToFragment(link) {
        let name = link.slice(1);
        const targets = Object.assign(Object.create(null), {
            "card": card,
            "compact": compact,
            "toggle": toggle
        });
        if (!(name in targets)) {
            try {
                name = decodeURIComponent(name);
            } catch (e) {
                name = null;
            }
        }
        const target = name === null ? undefined : targets[name];
        if (target) {
            const y = target.mapToItem(flickable.contentItem, 0, 0).y;
            flickable.contentY = Math.max(0, Math.min(y, flickable.contentHeight - flickable.height));
        } else if (name !== null && (name === "" || name.toLowerCase() === "top")) {
            flickable.contentY = 0;
        }
    }

    Component.onCompleted: {
        Page.__eldur_init(root);
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: Math.max(page.implicitHeight, initialContainingBlock.childrenRect.y + initialContainingBlock.childrenRect.height)

