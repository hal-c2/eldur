                // <main class="content">
                Item {
                    implicitWidth: contentContent.implicitWidth + 64
                    implicitHeight: contentContent.implicitHeight + 80
                    Layout.fillWidth: true
                    Layout.alignment: Qt.AlignHCenter
                    Layout.maximumWidth: 960

                    ColumnLayout {
                        id: contentContent
