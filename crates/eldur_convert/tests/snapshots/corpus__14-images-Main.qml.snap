                                Layout.maximumWidth: Math.ceil(implicitWidth)
                                Layout.fillHeight: false
                                Layout.alignment: Qt.AlignVCenter
                                Layout.leftMargin: 16

                                // <p class="author-name">
                                Text {
                                    id: authorName
                                    property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                    text: "Maren Holt"
                                    textFormat: Text.PlainText
                                    color: "#1f2430"
                                    font.family: "sans-serif"
                                    font.pixelSize: 18
                                    font.weight: 700
                                    lineHeight: 27.9
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 3.6
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                }

                                // <p class="author-bio">
                                Text {
                                    text: "Landscape photographer and writer based in the north. Shoots mostly on film."
                                    textFormat: Text.PlainText
                                    color: "#5c6578"
                                    font.family: "sans-serif"
                                    font.pixelSize: 14
                                    lineHeight: 21.7
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 2.8
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                    Layout.topMargin: 4 - authorName.eldurCarry
                                    Layout.preferredHeight: implicitHeight
                                }
                            }

                            Item {
                                Layout.fillWidth: true
                            }
                        }

                        // <section class="feature">
                        GridLayout {
                            columns: 2
                            columnSpacing: 32
                            rowSpacing: 32
                            Layout.fillWidth: true
                            Layout.maximumWidth: Number.POSITIVE_INFINITY
                            Layout.topMargin: 32

                            // <figure>
                            Rectangle {
                                color: "#fafbfd"
