                                                width: avatarCorners.width
                                                height: avatarCorners.height
                                            }

                                            PathRectangle {
                                                width: avatarCorners.width
                                                height: avatarCorners.height
                                                radius: 32
                                            }
                                        }
                                    }
                                }
                            }

                            // <div>
                            ColumnLayout {
                                spacing: 0
