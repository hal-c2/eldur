                                    transform: Translate {
                                        y: 4.4
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                }

                                // <p>
                                Text {
                                    id: p
                                    property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                    text: "The best light arrives in the few minutes before the sun clears the ridge. Planning the walk in the dark is most of the work."
                                    textFormat: Text.PlainText
                                    color: "#3a4256"
                                    font.family: "sans-serif"
                                    font.pixelSize: 16
                                    lineHeight: 24.8
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 3.2
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                    Layout.topMargin: 12 - h2.eldurCarry
                                }

                                // <p>
                                Text {
                                    text: "Each frame here was exposed for four seconds on a tripod, with the shutter released by a cable."
                                    textFormat: Text.PlainText
                                    color: "#3a4256"
                                    font.family: "sans-serif"
                                    font.pixelSize: 16
                                    lineHeight: 24.8
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 3.2
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                    Layout.topMargin: 12 - p.eldurCarry
