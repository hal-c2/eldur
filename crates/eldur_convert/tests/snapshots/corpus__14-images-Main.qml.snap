                                    id: avatarClip
                                    clip: true
                                    implicitWidth: 0
                                    implicitHeight: 0
                                    anchors.fill: parent

                                    Shape {
                                        id: avatarCorners
                                        anchors.fill: parent

                                        ShapePath {
                                            strokeWidth: -1
                                            fillColor: "#ffffff"
                                            fillRule: ShapePath.OddEvenFill

