                                    y: EldurFonts.shift("sans-serif", 28, 700, false, 35)
                                }
                                bottomPadding: EldurFonts.slack(font, lineHeight)
                                wrapMode: Text.WordWrap
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                renderType: Text.NativeRendering
                            }
                        }

                        // <p>
                        EldurLines {
                            id: pFlow2
                            property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                            color: "#1d1f23"
                            font.family: EldurFonts.family("serif")
                            font.pixelSize: 17
                            lineHeight: 27.2
                            Layout.fillWidth: true
                            Layout.topMargin: 14 - h23.eldurCarry
                            Layout.preferredHeight: implicitHeight

                            Text {
                                text: "Inline identifiers such as "
                                textFormat: Text.PlainText
                                color: "#1d1f23"
                                font.family: EldurFonts.family("serif")
                                font.pixelSize: 17
                                wrapMode: Text.WordWrap
                                renderType: Text.NativeRendering
                            }

                            Text {
                                id: inlineRun2
                                readonly property real eldurMarginRight: 5.35
                                readonly property real eldurMarginLeft: 5.35
                                property var eldurFragments: []

                                text: "line-height"
                                textFormat: Text.PlainText
                                color: "#1d1f23"
                                font.family: EldurFonts.family("monospace")
                                font.pixelSize: 15
                                font.letterSpacing: 0.18
                                wrapMode: Text.WordWrap
                                renderType: Text.NativeRendering

                                EldurInlineBox {
                                    fragments: inlineRun2.eldurFragments
