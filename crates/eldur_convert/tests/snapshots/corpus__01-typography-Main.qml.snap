                                        transform: Translate {
                                            y: EldurFonts.shift("serif", 17, 400, false, 27.2)
                                        }
                                        bottomPadding: EldurFonts.slack(font, lineHeight)
                                        wrapMode: Text.WordWrap
                                        anchors.left: parent.left
                                        anchors.right: parent.right
