                        // <pre>
                        Rectangle {
                            id: pre
                            property Item eldurScroller: preScroller
                            property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                            color: "#20242b"
                            radius: 6
                            clip: true
                            implicitWidth: preText.implicitWidth + 40
                            implicitHeight: preText.implicitHeight + 32
                            Layout.fillWidth: true
                            Layout.topMargin: 20 - pFlow2.eldurCarry
                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                            EldurScroller {
                                id: preScroller
                                x: 0
                                y: 0
                                width: parent.width
                                height: parent.height
                                scrollsY: false
                                stickPadTop: 16
                                stickPadRight: 20
                                stickPadBottom: 16
                                stickPadLeft: 20
                                contentWidth: Math.max(width, preText.contentWidth + 40)
                                contentHeight: height

                                Text {
                                    id: preText
                                    text: "body {\n  max-width: 760px;\n  margin: 0 auto;\n  line-height: 1.6;\n  font-size: 1.0625rem;\n}"
                                    textFormat: Text.PlainText
                                    color: "#e6e9ef"
