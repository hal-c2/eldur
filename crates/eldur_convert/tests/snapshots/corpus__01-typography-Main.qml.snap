                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                    }

                                    Rectangle {
                                        x: -17
                                        y: 12
                                        width: 5
                                        height: 5
                                        color: "#1d1f23"
                                        radius: 2.5
                                    }
                                }

                                // <li>
                                Item {
                                    id: li2
                                    property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                                    implicitWidth: liText2.implicitWidth
                                    implicitHeight: liText2.implicitHeight
                                    Layout.fillWidth: true
                                    Layout.topMargin: 4 - li.eldurCarry
                                    Layout.preferredHeight: implicitHeight

                                    Text {
                                        id: liText2
                                        text: "Keep measure between 45 and 75 characters."
                                        textFormat: Text.PlainText
                                        color: "#1d1f23"
                                        font.family: "serif"
                                        font.pixelSize: 17
                                        lineHeight: 27.2
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 3.83
                                        }
                                        wrapMode: Text.WordWrap
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                    }

                                    Rectangle {
                                        x: -17
                                        y: 12
                                        width: 5
                                        height: 5
                                        color: "#1d1f23"
                                        radius: 2.5
                                    }
                                }

                                // <li>
                                Item {
                                    id: li3
                                    property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                                    implicitWidth: liText3.implicitWidth
                                    implicitHeight: liText3.implicitHeight
                                    Layout.fillWidth: true
                                    Layout.topMargin: 4 - li2.eldurCarry
                                    Layout.preferredHeight: implicitHeight

                                    Text {
                                        id: liText3
                                        text: "Use one typeface family per role."
                                        textFormat: Text.PlainText
                                        color: "#1d1f23"
                                        font.family: "serif"
                                        font.pixelSize: 17
                                        lineHeight: 27.2
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 3.83
                                        }
                                        wrapMode: Text.WordWrap
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                    }

                                    Rectangle {
                                        x: -17
                                        y: 12
                                        width: 5
                                        height: 5
                                        color: "#1d1f23"
                                        radius: 2.5
                                    }
                                }
                            }
                        }

                        // <hr>
                        Rectangle {
                            id: hr
                            property real eldurCarry: Math.ceil(Layout.topMargin + 1) - Layout.topMargin - 1 + 0.000001

                            color: "#00000000"
                            clip: true
                            implicitWidth: 0
                            implicitHeight: 1
                            Layout.fillWidth: true
                            Layout.topMargin: 32 - ul.eldurCarry

                            Rectangle {
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                height: 1
                                color: "#d9d5c9"
                            }
                        }

                        // <p>
                        Text {
                            id: p12
                            property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                            text: "Continue reading in the next issue."
                            textFormat: Text.PlainText
                            color: "#1d1f23"
                            font.family: "serif"
                            font.pixelSize: 17
                            lineHeight: 27.2
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 3.83
                            }
                            wrapMode: Text.WordWrap
                            Layout.fillWidth: true
                            Layout.topMargin: 32 - hr.eldurCarry
                            Layout.preferredHeight: implicitHeight
                        }
                    }

                    // <footer>
                    Rectangle {
                        color: "#00000000"
                        implicitWidth: footerContent.implicitWidth
                        implicitHeight: footerContent.implicitHeight + 13
                        Layout.fillWidth: true
                        Layout.topMargin: 40 - main.eldurCarry
                        Layout.bottomMargin: 16

                        Rectangle {
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            height: 1
                            color: "#d9d5c9"
                        }

                        ColumnLayout {
                            id: footerContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.topMargin: 13

                            // <p>
                            Text {
                                id: p13
                                property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                                text: "Typography notes is a test page. All faces are generic families."
                                textFormat: Text.PlainText
                                color: "#5b616e"
                                font.family: "sans-serif"
                                font.pixelSize: 13
                                lineHeight: 20.8
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 2.93
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                Layout.preferredHeight: implicitHeight
                            }
                        }
                    }
                }
            }
        }
    }
}
