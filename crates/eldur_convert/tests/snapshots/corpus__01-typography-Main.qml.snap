                                    wrapMode: Text.NoWrap
                                    x: 20
                                    y: 16
                                    width: preScroller.width + -40
                                    renderType: Text.NativeRendering
                                }
                            }

                            Shape {
                                id: preCorners
                                anchors.fill: parent

                                ShapePath {
                                    strokeWidth: -1
                                    fillColor: "#fdfcf8"
                                    fillRule: ShapePath.OddEvenFill

                                    PathRectangle {
                                        width: preCorners.width
                                        height: preCorners.height
                                    }

                                    PathRectangle {
                                        width: preCorners.width
                                        height: preCorners.height
                                        radius: 6
                                    }
                                }
                            }
