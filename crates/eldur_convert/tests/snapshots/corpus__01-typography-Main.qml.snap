                                    font.pixelSize: 15
                                    font.letterSpacing: 0.18
                                    fill: "#f1efe8"
                                    radii: [3, 3, 3, 3]
                                    paddingTop: 1.53
                                    paddingBottom: 1.53
                                    reachLeft: 5.35
                                    reachRight: 5.35
                                }
                            }

