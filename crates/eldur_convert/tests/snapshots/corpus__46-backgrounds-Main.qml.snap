                                        position: 0
                                        color: "#f0abfc"
                                    }

                                    GradientStop {
                                        position: 0.7
                                        color: "#4c1d95"
                                    }
                                }

                                PathRectangle {
                                    width: divGradient12.width
                                    height: divGradient12.height
                                }
                            }
                        }
                    }

                    // <div id="repr">
                    Item {
                        id: repr
                        implicitWidth: 0
                        implicitHeight: 0
                        Layout.row: 4
                        Layout.column: 2
                        Layout.preferredWidth: 200
                        Layout.minimumWidth: 200
                        Layout.maximumWidth: 200
                        Layout.preferredHeight: 120
                        Layout.alignment: Qt.AlignTop

                        Shape {
                            id: divGradient13
                            anchors.fill: parent

                            ShapePath {
                                strokeWidth: -1
                                fillGradient: RadialGradient {
                                    centerX: divGradient13.width * 0.5
                                    centerY: divGradient13.height * 0.5
                                    centerRadius: Math.max(0.01, 20 + 0 * (Math.hypot(divGradient13.width * 0.5, divGradient13.height * 0.5)))
                                    focalX: divGradient13.width * 0.5
                                    focalY: divGradient13.height * 0.5
                                    focalRadius: 0 + 0 * (Math.hypot(divGradient13.width * 0.5, divGradient13.height * 0.5))
                                    spread: ShapeGradient.RepeatSpread

                                    GradientStop {
                                        position: 0
                                        color: "#1e293b"
                                    }

                                    GradientStop {
                                        position: 0.5
                                        color: "#1e293b"
                                    }

                                    GradientStop {
                                        position: 0.5001
                                        color: "#e2e8f0"
                                    }

                                    GradientStop {
                                        position: 1
                                        color: "#e2e8f0"
                                    }
                                }

                                PathRectangle {
                                    width: divGradient13.width
                                    height: divGradient13.height
                                }
                            }
                        }
                    }

