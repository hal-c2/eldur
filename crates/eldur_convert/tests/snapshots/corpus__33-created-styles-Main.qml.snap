    property var eldurLiteralClasses: []
    property bool eldurOpenElements: true
    readonly property var eldurInitialBlock: initialContainingBlock

    visible: true
    color: "#ffffff"
    title: "Created styles"
    width: 1280
    height: 800

    Component.onCompleted: {
        Page.__eldur_init(root);
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: Math.max(page.implicitHeight, initialContainingBlock.childrenRect.y + initialContainingBlock.childrenRect.height)

        // <html>
        ColumnLayout {
            id: page
            property string eldurTag: "html"

            spacing: 0
            width: flickable.width

            // <body>
            ColumnLayout {
                property string eldurTag: "body"

                spacing: 0
                Layout.fillWidth: true
                Layout.maximumWidth: Number.POSITIVE_INFINITY

                // <div id="board">
                Rectangle {
                    id: board
                    property string eldurTag: "div"
                    property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : 0

                    color: "#f0f2f8"
                    implicitWidth: Math.max(boardText.implicitWidth, divFlow.implicitWidth) + 24
                    implicitHeight: (boardText.text === "" ? 0 : boardText.implicitHeight) + divFlow.implicitHeight + 24
                    objectName: "board"
                    Layout.fillWidth: true
                    Layout.preferredHeight: implicitHeight

                    Text {
                        id: boardText
                        text: ""
                        textFormat: Text.PlainText
                        color: "#1e1e1e"
                        font.family: "sans-serif"
                        font.pixelSize: 16
                        lineHeight: 20
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: 1
                        }
                        wrapMode: Text.WordWrap
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        anchors.leftMargin: 12
                        anchors.rightMargin: 12
                        anchors.topMargin: 12
                        visible: text !== ""
                        renderType: Text.NativeRendering
                    }

                    ColumnLayout {
                        id: divFlow
                        spacing: 0
                        x: 12
                        y: (boardText.text === "" ? 0 : boardText.implicitHeight) + 12
                        width: parent.width - 24
                    }
                }
            }
        }

        Item {
            id: initialContainingBlock
            width: flickable.width
            height: flickable.height
        }
    }
}
