                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                            ColumnLayout {
                                id: statContent2
                                spacing: 0
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.leftMargin: 12
                                anchors.rightMargin: 12
                                anchors.topMargin: 12

                                // <div>
                                Text {
                                    readonly property FontMetrics metrics: FontMetrics {
                                        font.family: "Liberation Sans"
                                        font.pixelSize: 28
                                        font.weight: 700
                                    }

                                    text: "7"
                                    textFormat: Text.PlainText
                                    color: "#1b2231"
                                    font.family: "Liberation Sans"
                                    font.pixelSize: 28
                                    font.weight: 700
                                    lineHeight: 32
                                    lineHeightMode: Text.FixedHeight
                                    bottomPadding: Math.min(0, lineHeight - Math.ceil(metrics.height))
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                    renderType: Text.NativeRendering
                                }

                                Text {
                                    text: "releases"
                                    textFormat: Text.PlainText
                                    color: "#92400e"
                                    font.family: "Liberation Sans"
                                    font.pixelSize: 13
                                    lineHeight: 24
                                    lineHeightMode: Text.FixedHeight
                                    wrapMode: Text.WordWrap
                                    transform: Translate {
                                        y: 5
                                    }
                                    Layout.fillWidth: true
                                    renderType: Text.NativeRendering
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
