                                Layout.fillWidth: true
                                Layout.topMargin: 16
                                Layout.preferredHeight: implicitHeight - p.eldurCarry
                                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                Rectangle {
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    anchors.left: parent.left
                                    width: 4
                                    color: "#1d4ed8"
                                }

                                ColumnLayout {
                                    id: detailsContent
                                    spacing: 0
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.top: parent.top
                                    anchors.leftMargin: 20
                                    anchors.rightMargin: 16
                                    anchors.topMargin: 16

                                    // <h2>
                                    Text {
                                        property string eldurTag: "h2"
                                        property string eldurWs: "\n    "

                                        text: "About this widget"
                                        textFormat: Text.PlainText
                                        color: "#3a4256"
                                        font.family: "sans-serif"
                                        font.pixelSize: 15
                                        font.weight: 700
                                        lineHeight: 24
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 3
                                        }
                                        wrapMode: Text.WordWrap
                                        Layout.fillWidth: true
                                        renderType: Text.NativeRendering
                                    }

                                    // <p>
                                    Text {
                                        id: p
                                        property string eldurTag: "p"
                                        property string eldurWs: "\n    "
                                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : 0

                                        text: "The counter goes negative below zero and turns red. Text typed above is mirrored as you type."
                                        textFormat: Text.PlainText
                                        color: "#3a4256"
                                        font.family: "sans-serif"
                                        font.pixelSize: 14
                                        lineHeight: 22.4
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 3
                                        }
                                        wrapMode: Text.WordWrap
                                        Layout.fillWidth: true
                                        Layout.topMargin: 8
                                        Layout.preferredHeight: implicitHeight
                                        renderType: Text.NativeRendering
                                    }
                                }
                            }
                        }
                    }

                    Item {
                        id: item
                        property real eldurCarry: (h => Math.ceil(h) - h)(Math.max(0, ...Array.from(parent.children).filter(k => k.visible).map(k => k.implicitHeight))) + 0.000001

                        Layout.fillWidth: true
                    }
                }
            }
        }
    }
}
