                            Text {
                                property string eldurTag: "p"

                                text: "Whenever you want."
                                textFormat: Text.PlainText
                                color: "#222233"
                                font.family: EldurFonts.family("Arial, sans-serif")
                                font.pixelSize: 16
                                lineHeight: EldurFonts.normalLine(font)
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: EldurFonts.shift("Arial, sans-serif", 16, 400, false, 0)
                                }
                                bottomPadding: EldurFonts.slack(font, lineHeight)
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                Layout.topMargin: 8
                                renderType: Text.NativeRendering
                            }
                        }
                    }

                    EldurLines {
                        id: blockFlow
                        property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                        color: "#222233"
                        font.family: EldurFonts.family("Arial, sans-serif")
                        font.pixelSize: 16
                        Layout.fillWidth: true
                        Layout.topMargin: 8
                        Layout.preferredHeight: implicitHeight

                        // <button id="ask">
                        Button {
                            id: ask
                            property string eldurTag: "button"
                            property string eldurWs: "\n"

                            text: "Leave a note"
                            palette.buttonText: "#000000"
                            font.family: EldurFonts.family("Arial")
                            font.pixelSize: 13
                            background: Rectangle {
                                color: "#efefef"
                                radius: 2
                                border.width: 1
                                border.color: "#767676"
                                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                            }
                            topPadding: 3
                            rightPadding: 8
                            bottomPadding: 3
                            leftPadding: 8
                            implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                            contentItem: Text {
                                text: ask.text
                                font: ask.font
                                color: ask.palette.buttonText
                                horizontalAlignment: Text.AlignHCenter
                                verticalAlignment: Text.AlignVCenter
                                wrapMode: Text.WordWrap
                                renderType: Text.NativeRendering
                            }
                            implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                            objectName: "ask"
                            width: Math.min(implicitWidth, Math.max(blockFlow.width, Math.ceil((askWords.font, Math.max(...ask.text.split(/\s+/).map(w => askWords.advanceWidth(w)))) * 1.0256385) + leftPadding + rightPadding))

                            FontMetrics {
                                id: askWords
                                font: ask.font
                            }
                        }
                    }

                    // <div id="answer">
                    Text {
                        id: answer
                        property string eldurTag: "div"
                        property string eldurWs: "\n"
                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : blockFlow.eldurCarry

                        text: "No note yet"
                        textFormat: Text.PlainText
                        color: "#222233"
                        font.family: EldurFonts.family("Arial, sans-serif")
                        font.pixelSize: 16
                        lineHeight: EldurFonts.normalLine(font)
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: EldurFonts.shift("Arial, sans-serif", 16, 400, false, 0)
                        }
                        bottomPadding: EldurFonts.slack(font, lineHeight)
                        wrapMode: Text.WordWrap
                        objectName: "answer"
                        Layout.fillWidth: true
                        Layout.topMargin: 12 - blockFlow.eldurCarry
                        renderType: Text.NativeRendering
                    }

                    Item {
                        id: dialogSlot
                        property Item eldurBox: note
                        property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                        Layout.topMargin: -answer.eldurCarry
                        Layout.preferredHeight: implicitHeight
                    }
                }
            }
        }

        Item {
            id: initialContainingBlock
            width: flickable.width
            height: flickable.height

            // <dialog id="note">
            Rectangle {
                id: note
                property Item eldurSlot: dialogSlot
                property string eldurTag: "dialog"
                property string eldurWs: "\n"
                property string eldurWsEnd: "\n"

                color: "#ffffff"
                radius: 6
                implicitWidth: noteContent.implicitWidth + 36
                implicitHeight: noteContent.implicitHeight + 36
                border.width: 2
                border.color: "#444466"
                objectName: "note"
                visible: (dialogSlot.parent ? dialogSlot.parent.visible : false) && (false)
                width: 336
                x: 0 + (parent.width - width + 0 - 0) / 2
                y: root.staticY(dialogSlot, flickable.contentItem)
                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                ColumnLayout {
                    id: noteContent
                    spacing: 0
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: parent.top
                    anchors.leftMargin: 18
                    anchors.rightMargin: 18
                    anchors.topMargin: 18

                    // <h2>
                    Text {
                        property string eldurTag: "h2"
                        property string eldurWs: "\n"

                        text: "A note"
                        textFormat: Text.PlainText
                        color: "#000000"
                        font.family: EldurFonts.family("Arial, sans-serif")
                        font.pixelSize: 18
                        font.weight: 700
                        lineHeight: EldurFonts.normalLine(font)
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: EldurFonts.shift("Arial, sans-serif", 18, 700, false, 0)
                        }
                        bottomPadding: EldurFonts.slack(font, lineHeight)
                        wrapMode: Text.WordWrap
                        Layout.fillWidth: true
                        renderType: Text.NativeRendering
                    }

                    // <form id="noteform">
                    ColumnLayout {
                        id: noteform
                        property var eldurAttrs: ({ "method": "dialog" })
                        property string eldurTag: "form"
                        property string eldurWs: "\n"
                        property string eldurWsEnd: "\n"

                        spacing: 0
                        objectName: "noteform"
                        Layout.fillWidth: true
                        Layout.maximumWidth: Number.POSITIVE_INFINITY
                        Layout.topMargin: 8

                        EldurLines {
                            id: blockFlow2
                            property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                            color: "#000000"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 16
                            Layout.fillWidth: true
                            Layout.preferredHeight: implicitHeight

                            EldurRun {
                                readonly property string eldurInline: "{\"bare\":false,\"hoisted\":false,\"html\":false,\"k\":{\"bg\":\"rgba(0, 0, 0, 0)\",\"color\":\"rgb(0, 0, 0)\",\"display\":\"block\",\"family\":\"Arial, sans-serif\",\"italic\":false,\"kw\":3,\"size\":16.0,\"strike\":false,\"underline\":false,\"us\":16.0,\"visible\":true,\"weight\":400},\"kids\":[{\"attrs\":[[\"for\",\"text\"]],\"c\":{\"bg\":\"rgba(0, 0, 0, 0)\",\"color\":\"rgb(0, 0, 0)\",\"display\":\"inline\",\"family\":\"Arial, sans-serif\",\"italic\":false,\"kw\":3,\"size\":16.0,\"strike\":false,\"underline\":false,\"us\":16.0,\"visible\":true,\"weight\":400},\"kids\":[{\"text\":\"Your note\"}],\"tag\":\"label\"},{\"text\":\" \"}],\"pre\":false,\"strike\":false,\"underline\":false}"

                                text: "Your note "
                                color: "#000000"
                                font.family: "Arial, sans-serif"
                                font.pixelSize: 16

                                TapHandler {
                                    onTapped: (eventPoint, button) => {
                                        if (text.enabled) Eldur.afterTap(eventPoint, function () { Eldur.labelled(text); });
                                    }
                                }
                            }

                            // <input id="text">
                            TextField {
                                id: text
                                property var eldurAttrs: ({ "name": "text", "required": "" })
                                property string eldurTag: "input"
                                property string name: "text"
                                property string eldurWs: "\n"

                                color: "#000000"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 13
                                verticalAlignment: TextInput.AlignVCenter
                                background: Rectangle {
                                    color: "#ffffff"
                                    radius: 2
                                    border.width: 1
                                    border.color: "#767676"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 3
                                rightPadding: 4
                                bottomPadding: 3
                                leftPadding: 4
                                implicitHeight: 21
                                implicitWidth: 185
                                Accessible.name: "Your note"
                                objectName: "text"
                                width: implicitWidth
                                renderType: Text.NativeRendering
                            }
                        }

                        // <menu>
                        EldurLines {
                            id: menuFlow
                            property string eldurTag: "menu"
                            property string eldurWs: "\n"
                            property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : blockFlow2.eldurCarry

                            color: "#000000"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 16
                            Layout.fillWidth: true
                            Layout.topMargin: 12 - blockFlow2.eldurCarry
                            Layout.preferredHeight: implicitHeight

                            // <button id="cancel">
                            Button {
                                id: cancel
                                property var eldurAttrs: ({ "type": "button" })
                                property string eldurTag: "button"

                                text: "Cancel"
                                palette.buttonText: "#000000"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 13
                                background: Rectangle {
                                    color: "#efefef"
                                    radius: 2
                                    border.width: 1
                                    border.color: "#767676"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 3
                                rightPadding: 8
                                bottomPadding: 3
                                leftPadding: 8
                                implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                                contentItem: Text {
                                    text: cancel.text
                                    font: cancel.font
                                    color: cancel.palette.buttonText
                                    horizontalAlignment: Text.AlignHCenter
                                    verticalAlignment: Text.AlignVCenter
                                    wrapMode: Text.WordWrap
                                    renderType: Text.NativeRendering
                                }
                                implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                objectName: "cancel"
                                width: Math.min(implicitWidth, Math.max(menuFlow.width, Math.ceil((cancelWords.font, Math.max(...cancel.text.split(/\s+/).map(w => cancelWords.advanceWidth(w)))) * 1.0256385) + leftPadding + rightPadding))

                                FontMetrics {
                                    id: cancelWords
                                    font: cancel.font
                                }
                            }

                            EldurRun {
                                text: " "
                                color: "#000000"
                                font.family: "Arial, sans-serif"
                                font.pixelSize: 16
                            }

                            // <button id="save">
                            Button {
                                id: save
                                property var eldurAttrs: ({ "value": "saved" })
                                property string eldurTag: "button"
                                property string eldurWs: " "

                                text: "Save"
                                palette.buttonText: "#000000"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 13
                                background: Rectangle {
                                    color: "#efefef"
                                    radius: 2
                                    border.width: 1
                                    border.color: "#767676"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 3
                                rightPadding: 8
                                bottomPadding: 3
                                leftPadding: 8
                                implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                                contentItem: Text {
                                    text: save.text
                                    font: save.font
                                    color: save.palette.buttonText
                                    horizontalAlignment: Text.AlignHCenter
                                    verticalAlignment: Text.AlignVCenter
                                    wrapMode: Text.WordWrap
                                    renderType: Text.NativeRendering
                                }
                                implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                objectName: "save"
                                width: Math.min(implicitWidth, Math.max(menuFlow.width, Math.ceil((saveWords.font, Math.max(...save.text.split(/\s+/).map(w => saveWords.advanceWidth(w)))) * 1.0256385) + leftPadding + rightPadding))

                                FontMetrics {
                                    id: saveWords
                                    font: save.font
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
