                        Rectangle {
                            color: "#1d4ed8"
                            implicitWidth: 0
                            implicitHeight: 0
                            opacity: 0.5
                            width: 100
                            height: 60
                            x: 20
                            y: 20
                        }
                    }

                    // <div id="b-multiply">
                    Item {
                        id: bMultiply
                        implicitWidth: bMultiplyContent.implicitWidth
                        implicitHeight: bMultiplyContent.implicitHeight
                        Layout.row: 4
                        Layout.column: 0
                        Layout.preferredWidth: 150
                        Layout.minimumWidth: 150
                        Layout.maximumWidth: 150
                        Layout.preferredHeight: 100
                        Layout.alignment: Qt.AlignTop

                        Shape {
                            id: divGradient
                            anchors.fill: parent

                            ShapePath {
                                strokeWidth: -1
                                fillGradient: LinearGradient {
                                    x1: divGradient.width * 0.5
                                    y1: 0
                                    x2: divGradient.width * 0.5
                                    y2: divGradient.height

                                    GradientStop {
                                        position: 0
                                        color: "#f59e0b"
                                    }

                                    GradientStop {
                                        position: 1
                                        color: "#f59e0b"
                                    }
                                }

                                PathRectangle {
                                    width: divGradient.width
                                    height: divGradient.height
                                }
                            }
                        }

                        ColumnLayout {
                            id: bMultiplyContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top

                            // <div>
                            Rectangle {
                                color: "#06b6d4"
                                implicitWidth: 0
                                implicitHeight: 0
                                Layout.fillWidth: true
                                Layout.leftMargin: 20
                                Layout.rightMargin: 20
                                Layout.preferredHeight: 60
                                Layout.topMargin: 20
                                Layout.bottomMargin: 20
                            }
                        }
                    }

                    // <div id="b-backdrop">
                    Item {
                        id: bBackdrop
                        implicitWidth: 0
                        implicitHeight: 0
                        z: 1
                        Layout.row: 4
                        Layout.column: 1
                        Layout.preferredWidth: 150
                        Layout.minimumWidth: 150
                        Layout.maximumWidth: 150
                        Layout.preferredHeight: 100
                        Layout.alignment: Qt.AlignTop

                        Shape {
                            id: divGradient2
                            anchors.fill: parent

                            ShapePath {
                                strokeWidth: -1
                                fillGradient: LinearGradient {
                                    x1: 0
                                    y1: divGradient2.height * 0.5
                                    x2: divGradient2.width
                                    y2: divGradient2.height * 0.5

                                    GradientStop {
                                        position: 0
                                        color: "#ef4444"
                                    }

                                    GradientStop {
                                        position: 1
                                        color: "#3b82f6"
                                    }
                                }

                                PathRectangle {
                                    width: divGradient2.width
                                    height: divGradient2.height
                                }
                            }
                        }

                        Rectangle {
                            color: "#33ffffff"
                            implicitWidth: 0
                            implicitHeight: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.leftMargin: 20
                            anchors.rightMargin: 20
                            anchors.top: parent.top
                            anchors.bottom: parent.bottom
                            anchors.topMargin: 20
                            anchors.bottomMargin: 20
                        }
                    }

                    // <div id="t-hard" class="ts">
                    Item {
                        id: tHard
                        implicitWidth: shadowedText.implicitWidth
                        implicitHeight: shadowedText.implicitHeight
                        Layout.row: 4
                        Layout.column: 2
                        Layout.preferredWidth: 150
                        Layout.minimumWidth: 150
                        Layout.maximumWidth: 150
                        Layout.preferredHeight: 100
                        Layout.alignment: Qt.AlignTop

                        Text {
                            id: shadowedText
                            text: "Shadow"
                            textFormat: Text.PlainText
                            color: "#111111"
                            font.family: "sans-serif"
                            font.pixelSize: 20
                            lineHeight: 28
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 3
                            }
                            wrapMode: Text.WordWrap
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            renderType: Text.NativeRendering

                            EldurTextShadow {
                                source: shadowedText
                                x: 2
                                y: 2
                                color: "#dc2626"
                            }
                        }
                    }

                    // <div id="t-blur" class="ts">
                    Item {
                        id: tBlur
                        implicitWidth: shadowedText2.implicitWidth
                        implicitHeight: shadowedText2.implicitHeight
                        Layout.row: 4
                        Layout.column: 3
                        Layout.preferredWidth: 150
                        Layout.minimumWidth: 150
                        Layout.maximumWidth: 150
                        Layout.preferredHeight: 100
                        Layout.alignment: Qt.AlignTop

                        Text {
                            id: shadowedText2
                            text: "Shadow"
                            textFormat: Text.PlainText
                            color: "#111111"
                            font.family: "sans-serif"
                            font.pixelSize: 20
                            lineHeight: 28
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 3
                            }
                            wrapMode: Text.WordWrap
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            renderType: Text.NativeRendering

                            EldurTextShadow {
                                source: shadowedText2
                                x: 0
                                y: 0
                                color: "#2563eb"
                                blurDeviation: 3
                            }
                        }
                    }

                    // <div id="t-multi" class="ts">
                    Item {
                        id: tMulti
                        implicitWidth: shadowedText3.implicitWidth
                        implicitHeight: shadowedText3.implicitHeight
                        Layout.row: 4
                        Layout.column: 4
                        Layout.preferredWidth: 150
                        Layout.minimumWidth: 150
                        Layout.maximumWidth: 150
                        Layout.preferredHeight: 100
                        Layout.alignment: Qt.AlignTop

                        Text {
                            id: shadowedText3
                            text: "Shadow"
                            textFormat: Text.PlainText
                            color: "#111111"
                            font.family: "sans-serif"
                            font.pixelSize: 20
                            lineHeight: 28
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 3
                            }
                            wrapMode: Text.WordWrap
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            renderType: Text.NativeRendering

                            EldurTextShadow {
                                source: shadowedText3
                                x: -1
                                y: -1
                                color: "#dc2626"
                            }

                            EldurTextShadow {
                                source: shadowedText3
                                x: 1
                                y: 1
                                color: "#16a34a"
                            }
                        }
                    }

                    // <div id="t-em" class="ts">
                    Item {
                        id: tEm
                        implicitWidth: shadowedText4.implicitWidth
                        implicitHeight: shadowedText4.implicitHeight
                        Layout.row: 4
                        Layout.column: 5
                        Layout.preferredWidth: 150
                        Layout.minimumWidth: 150
                        Layout.maximumWidth: 150
                        Layout.preferredHeight: 100
                        Layout.alignment: Qt.AlignTop

                        Text {
                            id: shadowedText4
                            text: "Shadow"
                            textFormat: Text.PlainText
                            color: "#111111"
                            font.family: "sans-serif"
                            font.pixelSize: 24
                            lineHeight: 33.6
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 3
                            }
                            wrapMode: Text.WordWrap
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            renderType: Text.NativeRendering

                            EldurTextShadow {
                                source: shadowedText4
                                x: 2.4
                                y: 2.4
                                color: "#000000"
                                blurDeviation: 1.2
                            }
                        }
                    }

                    Item {
                        Layout.row: 0
                        Layout.column: 6
                        Layout.fillWidth: true
                    }
                }
            }
        }
    }
}
