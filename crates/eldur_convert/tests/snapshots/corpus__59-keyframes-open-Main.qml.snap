                    SequentialAnimation {
                        loops: 1

                        NumberAnimation {
                            target: itemMove2
                            property: "eldurPy"
                            from: 12
                            to: 0
                            duration: 300
                            easing.type: Easing.BezierSpline
                            easing.bezierCurve: [0, 0, 0.58, 1, 1, 1]
                        }
                    }
                }
            }
        }
    }
}
