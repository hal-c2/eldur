    readonly property var eldurTemplates: ({ "div.done.item@list": eldurT_div_0, "div.item@list": eldurT_div_0, "div.done.item@*": eldurT_div_1, "div.item@*": eldurT_div_1 })

    visible: true
    color: "#fafafa"
    title: "Motion with a script"
    width: 1280
    height: 800

    Component.onCompleted: {
        Page.__eldur_init(root);
        root.eldurAnimate = true;
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: page.implicitHeight

        EldurScrollInput {
            id: flickableInput
            scroller: flickable
            keySource: flickable.parent
            focus: true
        }

        // <html>
        ColumnLayout {
            id: page
            property var eldurAttrs: ({ "lang": "en" })
            property string eldurTag: "html"

            spacing: 0
            width: flickable.width

            // <body>
            Item {
                property string eldurTag: "body"
                property string eldurWsEnd: "\n\n"

                implicitWidth: bodyContent.implicitWidth + 32
                implicitHeight: bodyContent.implicitHeight + 32
                Layout.fillWidth: true

                ColumnLayout {
                    id: bodyContent
                    spacing: 0
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: parent.top
                    anchors.leftMargin: 16
                    anchors.rightMargin: 16
                    anchors.topMargin: 16

                    // <div id="list">
                    Item {
                        id: list
                        property string eldurTag: "div"
                        property string eldurKey: "list"
                        property string eldurWs: "\n"
                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : 0

                        implicitWidth: Math.max(listText.implicitWidth, divFlow.implicitWidth) + 0
                        implicitHeight: (listText.text === "" ? 0 : listText.implicitHeight) + divFlow.implicitHeight + 0
                        objectName: "list"
                        Layout.fillWidth: true
                        Layout.preferredHeight: implicitHeight

                        Text {
                            id: listText
                            text: ""
                            textFormat: Text.PlainText
                            color: "#222222"
                            font.family: "sans-serif"
                            font.pixelSize: 16
                            lineHeight: 24
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 3
                            }
                            wrapMode: Text.WordWrap
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            visible: text !== ""
                            renderType: Text.NativeRendering
                        }

                        ColumnLayout {
                            id: divFlow
                            spacing: 0
                            x: 0
                            y: (listText.text === "" ? 0 : listText.implicitHeight) + 0
                            width: parent.width - 0
                        }
                    }
                }
            }
        }
    }

    // <div class="item"> created by a script, in list
    Component {
        id: eldurT_div_0

        Rectangle {
            id: item
            property string eldurTag: "div"
            property string eldurClasses: ""
            property string eldurTemplate: "eldurT_div_0"
            property bool cls_done: false

            color: item.cls_done ? "#ddeedd" : "#ddddee"
            implicitWidth: itemText.implicitWidth + 16
            implicitHeight: itemText.implicitHeight + 16
            transform: [
                Translate {
                    id: itemMove
                    property real eldurPx: 0
                    property real eldurPy: 0
                    property real eldurFx: 0
                    property real eldurFy: 0

                    x: eldurPx + item.width * eldurFx / 100
                    y: eldurPy + item.height * eldurFy / 100
                }
            ]
            Layout.fillWidth: true

            Behavior on color {
                ColorAnimation {
                    duration: root.eldurAnimate ? 200 : 0
                    easing.type: Easing.BezierSpline
                    easing.bezierCurve: [0.25, 0.1, 0.25, 1, 1, 1]
                }
            }

            Text {
                id: itemText
                text: ""
                textFormat: Text.PlainText
                color: "#222222"
                font.family: "sans-serif"
                font.pixelSize: 16
                lineHeight: 24
                lineHeightMode: Text.FixedHeight
                transform: Translate {
                    y: 3
                }
                wrapMode: Text.WordWrap
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.leftMargin: 8
                anchors.rightMargin: 8
                anchors.topMargin: 8
                renderType: Text.NativeRendering
            }

            SequentialAnimation {
                running: true

                PropertyAction {
                    target: item
                    property: "opacity"
                    value: 0
                }

                PropertyAction {
                    target: itemMove
                    property: "eldurPy"
                    value: 12
                }

                ParallelAnimation {
                    SequentialAnimation {
                        loops: 1

                        NumberAnimation {
                            target: item
                            property: "opacity"
                            from: 0
                            to: 1
                            duration: 300
                            easing.type: Easing.BezierSpline
                            easing.bezierCurve: [0, 0, 0.58, 1, 1, 1]
                        }
