                            contentWidth: Math.max(width, oPosContent.childrenRect.x + oPosContent.childrenRect.width, positionedScrollerOverlays.childrenRect.x + positionedScrollerOverlays.childrenRect.width)
                            contentHeight: Math.max(height, oPosContent.implicitHeight, positionedScrollerOverlays.childrenRect.y + positionedScrollerOverlays.childrenRect.height)

                            ColumnLayout {
