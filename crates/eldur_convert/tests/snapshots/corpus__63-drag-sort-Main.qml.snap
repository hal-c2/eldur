                                textFormat: Text.PlainText
                                color: "#222222"
                                font.family: "Arial"
                                font.pixelSize: 16
                                lineHeight: 44
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 13
                                }
                                wrapMode: Text.WordWrap
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.leftMargin: 13
                                anchors.rightMargin: 13
                                anchors.topMargin: 1
                                renderType: Text.NativeRendering
                            }
                        }

                        Rectangle {
                            id: r3
                            property Item eldurSlot: rowSlot4
                            property string eldurStyle: "top: 150px"
                            property string eldurTag: "div"
                            property string eldurClasses: "row"
                            property bool cls_lift: false
                            property string eldurWs: "\n"

                            color: r3.cls_lift ? "#cfe0ff" : "#eef2f8"
                            implicitWidth: r3Text.implicitWidth + 26
                            implicitHeight: r3Text.implicitHeight + 2
                            border.width: 1
                            border.color: "#c3cbd9"
                            objectName: "r3"
                            width: 300
                            height: 44
                            x: 0
                            y: 150
                            visible: rowSlot4.parent ? rowSlot4.parent.visible : false
                            z: r3.cls_lift ? 2 : 0

                            Text {
                                id: r3Text
                                text: "Ship"
                                textFormat: Text.PlainText
                                color: "#222222"
                                font.family: "Arial"
                                font.pixelSize: 16
                                lineHeight: 44
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 13
                                }
                                wrapMode: Text.WordWrap
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.leftMargin: 13
                                anchors.rightMargin: 13
                                anchors.topMargin: 1
                                renderType: Text.NativeRendering
                            }
                        }
                    }

                    // <div id="order">
                    Text {
                        id: order
                        property string eldurTag: "div"
                        property string eldurWs: "\n"
                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : list.eldurCarry

                        text: "Plan, Build, Test, Ship"
                        textFormat: Text.PlainText
                        color: "#222222"
                        font.family: "Arial"
                        font.pixelSize: 16
                        wrapMode: Text.WordWrap
                        objectName: "order"
                        Layout.fillWidth: true
                        Layout.topMargin: 16 - list.eldurCarry
                        Layout.preferredHeight: implicitHeight
                        renderType: Text.NativeRendering
                    }
                }
            }
        }
    }
}
