                implicitHeight: bodyContent.implicitHeight + 64
                Layout.fillWidth: true

                ColumnLayout {
                    id: bodyContent
                    spacing: 0
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: parent.top
                    anchors.leftMargin: 32
                    anchors.rightMargin: 32
                    anchors.topMargin: 32

                    // <h1>
                    Text {
                        id: h1
                        property string eldurTag: "h1"
                        property string eldurWs: "\n"
                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001) : 0

                        text: "Order the steps"
                        textFormat: Text.PlainText
                        color: "#222222"
                        font.family: "Arial"
                        font.pixelSize: 22
                        font.weight: 700
                        wrapMode: Text.WordWrap
                        Layout.fillWidth: true
                        renderType: Text.NativeRendering
                    }

                    // <div id="list">
                    Item {
                        id: list
                        property string eldurTag: "div"
                        property string eldurWs: "\n"
                        property string eldurWsEnd: "\n"
                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + 200) - Layout.topMargin - 200 + 0.000001) : h1.eldurCarry

                        implicitWidth: listContent.implicitWidth
                        implicitHeight: listContent.implicitHeight
                        objectName: "list"
                        z: r0.cls_lift ? 3 : (r1.cls_lift ? 3 : (r2.cls_lift ? 3 : (r3.cls_lift ? 3 : 1)))
                        Layout.preferredWidth: 300
                        Layout.rightMargin: parent instanceof ColumnLayout ? -Layout.preferredWidth : 0
                        Layout.preferredHeight: 200
                        Layout.topMargin: 12 - h1.eldurCarry

                        ColumnLayout {
                            id: listContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top

