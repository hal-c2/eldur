                    // <main class="content">
                    Item {
                        implicitWidth: contentContent.implicitWidth + 96
                        implicitHeight: contentContent.implicitHeight + 96
                        Layout.fillWidth: true
                        Layout.preferredWidth: 0
                        Layout.maximumWidth: 820
                        Layout.fillHeight: true
                        Layout.horizontalStretchFactor: 1000000

                        ColumnLayout {
                            id: contentContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.leftMargin: 48
                            anchors.rightMargin: 48
                            anchors.topMargin: 32

                            // <h1>
                            Text {
                                text: "Configuration"
                                textFormat: Text.PlainText
                                color: "#24292f"
                                font.family: "sans-serif"
                                font.pixelSize: 32
                                font.weight: 700
                                lineHeight: 40
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 2
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                            }

                            // <p class="subtitle">
                            Text {
                                id: subtitle
                                property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                text: "Tell the scheduler where your queues live and how hard to try."
                                textFormat: Text.PlainText
                                color: "#57606a"
                                font.family: "sans-serif"
                                font.pixelSize: 18
                                lineHeight: 28.8
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 4
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                Layout.topMargin: 8
                            }

                            // <p>
                            Text {
                                id: p
                                property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                text: "<div style=\"line-height:25.6px\">Tidewater reads its settings from <span style=\"font-size:14px;font-family:'monospace';background-color:#eff1f3\"><span style=\"letter-spacing:5px\">&#8288;</span>tidewater.toml<span style=\"letter-spacing:5px\">&#8288;</span></span> in the working directory. Every key can be overridden with an environment variable: <span style=\"font-size:14px;font-family:'monospace';background-color:#eff1f3\"><span style=\"letter-spacing:5px\">&#8288;</span>queue.url<span style=\"letter-spacing:5px\">&#8288;</span></span> becomes <span style=\"font-size:14px;font-family:'monospace';background-color:#eff1f3\"><span style=\"letter-spacing:5px\">&#8288;</span>TIDEWATER_QUEUE_URL<span style=\"letter-spacing:5px\">&#8288;</span></span>.</div>"
                                textFormat: Text.RichText
                                color: "#24292f"
                                font.family: "sans-serif"
                                font.pixelSize: 16
                                wrapMode: Text.WordWrap
                                transform: Translate {
                                    y: -3.6
                                }
                                Layout.fillWidth: true
                                Layout.topMargin: 16 - subtitle.eldurCarry
                            }

                            // <div class="callout">
                            Rectangle {
                                id: callout
                                property real eldurCarry: Math.ceil(Layout.topMargin - (text.eldurCarry)) - Layout.topMargin + text.eldurCarry + 0.000001

                                color: "#ddf4ff"
                                topLeftRadius: 0
                                topRightRadius: 6
                                bottomRightRadius: 6
                                bottomLeftRadius: 0
                                implicitWidth: calloutContent.implicitWidth + 36
                                implicitHeight: calloutContent.implicitHeight + 24
                                Layout.fillWidth: true
                                Layout.topMargin: 16 - p.eldurCarry
                                Layout.preferredHeight: implicitHeight - text.eldurCarry
                                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                Rectangle {
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    anchors.left: parent.left
                                    width: 4
                                    color: "#0969da"
                                }

