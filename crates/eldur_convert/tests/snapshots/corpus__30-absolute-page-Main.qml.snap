// Generated by Eldur from index.html. Do not edit.

import QtQuick
import QtQuick.Controls.Basic
import QtQuick.Layouts

ApplicationWindow {
    id: root
    visible: true
    color: "#f9fafb"
    title: "Absolute boxes without a positioned ancestor"
    width: 1280
    height: 800

    function staticX(item, block) {
        let at = 0
        for (; item && item !== block; item = item.parent) at += item.x
        return at
    }

    function staticY(item, block) {
        let at = 0
        for (; item && item !== block; item = item.parent) at += item.y
        return at
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: Math.max(page.implicitHeight, initialContainingBlock.childrenRect.y + initialContainingBlock.childrenRect.height)

        Item {
            width: flickable.width
            height: flickable.height
            z: -1

            // <div class="behind">
            Rectangle {
                color: "#bbf7d0"
                implicitWidth: 0
                implicitHeight: 0
                z: -1
                width: 200
                height: 90
                x: 12
                y: 60
            }
        }

        // <html>
        ColumnLayout {
            id: page
            spacing: 0
            width: flickable.width

            // <body>
            ColumnLayout {
                spacing: 0
                Layout.fillWidth: true
                Layout.maximumWidth: Number.POSITIVE_INFINITY

                // <main>
                Item {
                    implicitWidth: mainContent.implicitWidth + 48
                    implicitHeight: mainContent.implicitHeight + 48
                    z: 1
                    Layout.fillWidth: true
                    Layout.maximumWidth: 768

                    ColumnLayout {
                        id: mainContent
                        spacing: 0
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        anchors.leftMargin: 24
                        anchors.rightMargin: 24
                        anchors.topMargin: 24

                        // <h1>
                        Text {
                            text: "Placed against the page"
                            textFormat: Text.PlainText
                            color: "#1f2937"
                            font.family: "sans-serif"
                            font.pixelSize: 28
                            font.weight: 700
                            lineHeight: 36
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 2
                            }
                            wrapMode: Text.WordWrap
                            Layout.fillWidth: true
                            renderType: Text.NativeRendering
                        }

                        // <p>
                        Text {
                            text: "None of the coloured boxes has a positioned ancestor, so each is placed against the initial containing block: the viewport's size, at the page's origin, scrolling with the page."
                            textFormat: Text.PlainText
                            color: "#1f2937"
                            font.family: "sans-serif"
                            font.pixelSize: 16
                            lineHeight: 24
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: 3
                            }
                            wrapMode: Text.WordWrap
                            Layout.fillWidth: true
                            Layout.topMargin: 12
                            renderType: Text.NativeRendering
                        }

                        Item {
                            id: noteSlot
                        }

                        // <p>
                        ColumnLayout {
                            spacing: 0
                            Layout.fillWidth: true
                            Layout.maximumWidth: Number.POSITIVE_INFINITY
                            Layout.topMargin: 16

                            Text {
                                text: "The blue note stays where this paragraph starts, on top of it, and takes no room. The orange dot was an inline box in this sentence and does not split it."
                                textFormat: Text.PlainText
                                color: "#1f2937"
                                font.family: "sans-serif"
                                font.pixelSize: 16
                                lineHeight: 24
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 3
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                renderType: Text.NativeRendering
                            }
                        }

                        // <div class="frame">
                        Rectangle {
                            color: "#e5e7eb"
                            implicitWidth: 0
                            implicitHeight: 0
                            z: 1
                            transform: Translate {
                                x: 20
                            }
                            Layout.fillWidth: true
                            Layout.preferredHeight: 80
                            Layout.topMargin: 16

                            Rectangle {
                                color: "#0f766e"
                                implicitWidth: 0
                                implicitHeight: 0
                                width: 40
                                height: 40
                                x: 8
                                y: 8
                            }
                        }

                        // <div class="row">
                        Item {
                            implicitWidth: rowContent.implicitWidth
                            implicitHeight: rowContent.implicitHeight
                            Layout.fillWidth: true
                            Layout.preferredHeight: 40
                            Layout.topMargin: 16

                            RowLayout {
                                id: rowContent
                                spacing: 12
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.bottom: parent.bottom

                                // <b>
                                Rectangle {
                                    color: "#d1d5db"
                                    implicitWidth: 0
                                    implicitHeight: 0
                                    Layout.fillWidth: true
                                    Layout.preferredWidth: 0
                                    Layout.fillHeight: true
                                }

                                // <b>
                                Rectangle {
                                    color: "#d1d5db"
                                    implicitWidth: 0
                                    implicitHeight: 0
                                    Layout.fillWidth: true
                                    Layout.preferredWidth: 0
                                    Layout.fillHeight: true
                                }

                                // <b>
                                Rectangle {
                                    color: "#d1d5db"
                                    implicitWidth: 0
                                    implicitHeight: 0
                                    Layout.fillWidth: true
                                    Layout.preferredWidth: 0
                                    Layout.fillHeight: true
                                }
                            }
                        }

                        // <section>
                        ColumnLayout {
                            spacing: 0
                            Layout.fillWidth: true
                            Layout.maximumWidth: Number.POSITIVE_INFINITY
                            Layout.bottomMargin: 16

                            // <div>
                            ColumnLayout {
                                spacing: 0
                                Layout.fillWidth: true
                                Layout.maximumWidth: Number.POSITIVE_INFINITY

                                // <p>
                                Text {
                                    text: "The red box far below is as deep as this text, and it makes the page scroll."
                                    textFormat: Text.PlainText
                                    color: "#1f2937"
                                    font.family: "sans-serif"
                                    font.pixelSize: 16
                                    lineHeight: 24
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 3
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                    renderType: Text.NativeRendering
                                }
                            }
                        }
                    }
                }
            }
        }

        Item {
            id: initialContainingBlock
            width: flickable.width
            height: flickable.height

            // <div class="ribbon">
            Rectangle {
                color: "#dc2626"
                implicitWidth: 0
                implicitHeight: 0
                z: 2
                width: 120
                height: 32
                anchors.right: parent.right
                anchors.rightMargin: 16
                y: 16
            }

            // <div class="band">
            Rectangle {
                color: "#2563eb"
                implicitWidth: 0
                implicitHeight: 0
                height: 12
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.leftMargin: 0
                anchors.rightMargin: 0
                anchors.bottom: parent.bottom
                anchors.bottomMargin: 0
            }

            // <div class="half">
            Rectangle {
                color: "#fde68a"
                implicitWidth: 0
                implicitHeight: 0
                width: parent.width * 0.2
                height: parent.height * 0.25
                x: parent.width * 0.75
                y: parent.height * 0.25
            }

            // <div class="note">
            Rectangle {
                color: "#c7d2fe"
                implicitWidth: 0
                implicitHeight: 0
                width: 160
                height: 48
                x: 480
                y: root.staticY(noteSlot, flickable.contentItem) + 16
            }

            // <span class="dot">
            Rectangle {
                color: "#f97316"
                radius: 6
                implicitWidth: 0
                implicitHeight: 0
                width: 12
                height: 12
                x: 4
                y: 240
                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
            }

            // <u>
            Rectangle {
                color: "#a78bfa"
                implicitWidth: 0
                implicitHeight: 0
                width: 60
                height: 24
                x: 680
                y: 620
            }

            // <div class="below">
            Rectangle {
                color: "#fca5a5"
                implicitWidth: 0
                implicitHeight: 0
                width: 300
                height: 40
                x: 24
                y: 1000
            }
        }
    }
}
