                                textFormat: Text.PlainText
                                color: "#5c6578"
                                font.family: "sans-serif"
                                font.pixelSize: 15
                                lineHeight: 22.8
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 2
