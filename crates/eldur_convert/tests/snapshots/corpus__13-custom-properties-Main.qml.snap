                                        y: 3
                                    }
                                    topPadding: 0.76
                                }

                                Item {
                                    width: tagBox3.width + 12
                                    height: tagBox3.height + 6.5

                                    Rectangle {
                                        id: tagBox3
                                        color: "#f5f7fb"
                                        radius: 6
                                        implicitWidth: tagText3.implicitWidth + 16
                                        implicitHeight: tagText3.implicitHeight + 8
                                        width: Math.min(implicitWidth, blockFlow2.width - 12)
                                        antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                        Text {
                                            id: tagText3
                                            text: "--radius"
                                            textFormat: Text.PlainText
                                            color: "#3b5bdb"
                                            font.family: "monospace"
                                            font.pixelSize: 13
                                            lineHeight: 19.5
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 1
                                            }
                                            wrapMode: Text.WordWrap
                                            anchors.left: parent.left
                                            anchors.right: parent.right
                                            anchors.top: parent.top
                                            anchors.leftMargin: 8
                                            anchors.rightMargin: 8
                                            anchors.topMargin: 4
                                        }
                                    }
                                }

                                Text {
                                    text: " "
                                    textFormat: Text.PlainText
                                    color: "#1c2233"
                                    font.family: "sans-serif"
                                    font.pixelSize: 16
                                    lineHeight: 24
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 3
                                    }
                                    topPadding: 0.76
                                }

                                Item {
                                    width: tagBox4.width + 12
                                    height: tagBox4.height + 6.5

                                    Rectangle {
                                        id: tagBox4
                                        color: "#f5f7fb"
                                        radius: 6
                                        implicitWidth: tagText4.implicitWidth + 16
                                        implicitHeight: tagText4.implicitHeight + 8
                                        width: Math.min(implicitWidth, blockFlow2.width - 12)
                                        antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                        Text {
                                            id: tagText4
                                            text: "--font-mono"
                                            textFormat: Text.PlainText
                                            color: "#3b5bdb"
                                            font.family: "monospace"
                                            font.pixelSize: 13
                                            lineHeight: 19.5
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 1
                                            }
                                            wrapMode: Text.WordWrap
                                            anchors.left: parent.left
                                            anchors.right: parent.right
                                            anchors.top: parent.top
                                            anchors.leftMargin: 8
                                            anchors.rightMargin: 8
                                            anchors.topMargin: 4
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // <article id="components" class="card">
                    Rectangle {
                        id: components
                        color: "#ffffff"
                        radius: 12
                        implicitWidth: componentsContent.implicitWidth + 32
                        implicitHeight: componentsContent.implicitHeight + 32
                        Layout.fillWidth: true
                        Layout.preferredWidth: 0
                        Layout.fillHeight: true
                        antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                        RectangularShadow {
                            anchors.fill: parent
                            z: -1
                            offset: Qt.vector2d(0, 6)
                            blur: 23.6
                            color: "#1f1c2233"
                            radius: 12
                        }

                        ColumnLayout {
                            id: componentsContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.leftMargin: 16
                            anchors.rightMargin: 16
                            anchors.topMargin: 16

                            // <h2>
                            Text {
                                id: h24
                                property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                text: "Components"
                                textFormat: Text.PlainText
                                color: "#1c2233"
                                font.family: "sans-serif"
                                font.pixelSize: 18
                                font.weight: 700
                                lineHeight: 26.4
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 3
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                            }

                            // <p>
                            Text {
                                id: p4
                                property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                text: "Buttons take their colour from the same tokens and darken on hover."
                                textFormat: Text.PlainText
                                color: "#5c6578"
                                font.family: "sans-serif"
                                font.pixelSize: 15
                                lineHeight: 22.8
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 2
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                Layout.topMargin: 8.8 - h24.eldurCarry
                            }

                            Flow {
                                id: blockFlow3
                                Layout.fillWidth: true
                                Layout.topMargin: 15.2 - p4.eldurCarry
                                Layout.preferredHeight: implicitHeight

                                Rectangle {
                                    id: button
                                    color: buttonHover.hovered ? "#2f4ac0" : "#3b5bdb"
                                    radius: 6
                                    implicitWidth: buttonText.implicitWidth + 35.2
                                    implicitHeight: buttonText.implicitHeight + 16
                                    width: Math.min(implicitWidth, blockFlow3.width)
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                                    Text {
                                        id: buttonText
                                        text: "Read the docs"
                                        textFormat: Text.PlainText
                                        color: "#ffffff"
                                        font.family: "sans-serif"
                                        font.pixelSize: 16
                                        font.weight: 600
                                        lineHeight: 24
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 3
                                        }
                                        wrapMode: Text.WordWrap
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                        anchors.leftMargin: 17.6
                                        anchors.rightMargin: 17.6
                                        anchors.topMargin: 8
                                    }

                                    HoverHandler {
                                        id: buttonHover
                                    }
                                }
                            }
                        }
                    }

                    // <article class="card">
                    Rectangle {
                        color: "#ffffff"
                        radius: 12
                        implicitWidth: cardContent3.implicitWidth + 32
                        implicitHeight: cardContent3.implicitHeight + 32
                        Layout.fillWidth: true
                        Layout.preferredWidth: 0
                        Layout.fillHeight: true
                        antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                        RectangularShadow {
                            anchors.fill: parent
                            z: -1
                            offset: Qt.vector2d(0, 6)
                            blur: 23.6
                            color: "#1f1c2233"
                            radius: 12
                        }

                        ColumnLayout {
                            id: cardContent3
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.leftMargin: 16
                            anchors.rightMargin: 16
                            anchors.topMargin: 16

                            // <h2>
                            Text {
