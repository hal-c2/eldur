                // <footer class="site-footer">
                Item {
                    id: siteFooter
                    property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                    implicitWidth: siteFooterText.implicitWidth + 64
                    implicitHeight: siteFooterText.implicitHeight + 32
                    Layout.fillWidth: true
                    Layout.topMargin: 32 - stats.eldurCarry

                    Text {
                        id: siteFooterText
