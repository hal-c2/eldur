                // <section class="stats">
                Rectangle {
                    id: stats
                    property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                    color: "#ffffff"
                    radius: 12
                    implicitWidth: statsContent.implicitWidth + 32
                    implicitHeight: statsContent.implicitHeight + 32
                    Layout.fillWidth: true
                    Layout.maximumWidth: Math.max(0, parent.width - 32)
                    Layout.alignment: Qt.AlignHCenter
                    Layout.topMargin: 32 - layout.eldurCarry
                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                    RectangularShadow {
                        anchors.fill: parent
                        z: -1
