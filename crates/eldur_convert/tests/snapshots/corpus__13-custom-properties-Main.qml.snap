                                property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                text: "Typography"
                                textFormat: Text.PlainText
                                color: "#1c2233"
                                font.family: "sans-serif"
                                font.pixelSize: 18
                                font.weight: 700
                                lineHeight: 26.4
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 3
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                            }

                            // <p>
                            Text {
                                text: "The hero heading uses clamp() so it scales smoothly between a minimum and a maximum size."
                                textFormat: Text.PlainText
                                color: "#5c6578"
                                font.family: "sans-serif"
                                font.pixelSize: 15
                                lineHeight: 22.8
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 2
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                Layout.topMargin: 8.8 - h25.eldurCarry
                                Layout.bottomMargin: 15.2
                            }
                        }
                    }

                    // <article id="docs" class="card">
                    Rectangle {
                        id: docs
                        color: "#ffffff"
                        radius: 12
                        implicitWidth: docsContent.implicitWidth + 32
                        implicitHeight: docsContent.implicitHeight + 32
                        Layout.fillWidth: true
