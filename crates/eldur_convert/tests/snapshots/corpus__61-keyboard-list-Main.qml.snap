                                    font.family: EldurFonts.family("Arial, sans-serif")
                                    font.pixelSize: 16
                                    lineHeight: EldurFonts.normalLine(font)
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: i3.cls_picked ? EldurFonts.shift("Arial, sans-serif", 16, 700, false, 0) : EldurFonts.shift("Arial, sans-serif", 16, 400, false, 0)
                                    }
                                    bottomPadding: EldurFonts.slack(font, lineHeight)
                                    wrapMode: Text.WordWrap
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.top: parent.top
                                    anchors.leftMargin: 12
                                    anchors.rightMargin: 12
                                    anchors.topMargin: 8
                                    renderType: Text.NativeRendering
                                    font.weight: i3.cls_picked ? 700 : 400
                                }

                                TapHandler {
                                    onTapped: parent.forceActiveFocus()
                                }
                            }
                        }
                    }

                    // <div id="state">
                    Item {
                        id: state
                        property string eldurTag: "div"
                        property string eldurWs: "\n"
                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + 20) - Layout.topMargin - 20 + 0.000001) : list.eldurCarry

                        implicitWidth: stateText.implicitWidth
                        implicitHeight: stateText.implicitHeight
                        objectName: "state"
                        Layout.fillWidth: true
                        Layout.preferredHeight: 20
                        Layout.topMargin: 12 - list.eldurCarry

                        Text {
                            id: stateText
                            text: "Nothing picked"
                            textFormat: Text.PlainText
                            color: "#222222"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 16
                            lineHeight: EldurFonts.normalLine(font)
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: EldurFonts.shift("Arial, sans-serif", 16, 400, false, 0)
                            }
                            bottomPadding: EldurFonts.slack(font, lineHeight)
                            wrapMode: Text.WordWrap
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            renderType: Text.NativeRendering
                        }
                    }

                    EldurLines {
                        id: blockFlow2
                        property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                        color: "#222222"
                        font.family: EldurFonts.family("Arial, sans-serif")
                        font.pixelSize: 16
                        Layout.fillWidth: true
                        Layout.topMargin: -state.eldurCarry
                        Layout.preferredHeight: implicitHeight

                        // <button id="after">
                        Button {
                            id: after
                            property string eldurTag: "button"
                            property string eldurWs: "\n"

                            text: "After the list"
                            palette.buttonText: "#000000"
                            font.family: EldurFonts.family("Arial")
                            font.pixelSize: 13
                            background: Rectangle {
                                color: "#efefef"
                                radius: 2
                                border.width: 1
                                border.color: "#767676"
                                antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                            }
                            topPadding: 3
                            rightPadding: 8
                            bottomPadding: 3
                            leftPadding: 8
                            implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                            contentItem: Text {
                                text: after.text
                                font: after.font
                                color: after.palette.buttonText
                                horizontalAlignment: Text.AlignHCenter
                                verticalAlignment: Text.AlignVCenter
                                wrapMode: Text.WordWrap
                                renderType: Text.NativeRendering
                            }
                            implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                            objectName: "after"
                            width: Math.min(implicitWidth, Math.max(blockFlow2.width, Math.ceil((afterWords.font, Math.max(...after.text.split(/\s+/).map(w => afterWords.advanceWidth(w)))) * 1.0256385) + leftPadding + rightPadding))

                            Keys.onPressed: (event) => {
                                event.accepted = !Eldur.fire(after, "keydown", event);
                            }
                            Keys.onReleased: (event) => {
                                event.accepted = !Eldur.fire(after, "keyup", event);
                            }

                            FontMetrics {
                                id: afterWords
                                font: after.font
                            }
                        }
                    }
                }
            }
        }
    }
}
