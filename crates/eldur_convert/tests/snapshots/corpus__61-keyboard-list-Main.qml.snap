    visible: true
    color: "#ffffff"
    title: "Keyboard list"
    width: 1280
    height: 800

    Component.onCompleted: {
        Page.__eldur_init(root);
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: page.implicitHeight

        EldurScrollInput {
            id: flickableInput
            scroller: flickable
            keySource: flickable.parent
            focus: true
        }

        // <html>
        ColumnLayout {
            id: page
            property string eldurTag: "html"

            spacing: 0
            width: flickable.width

            // <body>
            Item {
                property string eldurTag: "body"
                property string eldurWs: "\n"
                property string eldurWsEnd: "\n\n\n"

                implicitWidth: bodyContent.implicitWidth + 64
                implicitHeight: bodyContent.implicitHeight + 64
                Layout.fillWidth: true

                ColumnLayout {
                    id: bodyContent
                    spacing: 0
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: parent.top
                    anchors.leftMargin: 32
                    anchors.rightMargin: 32
                    anchors.topMargin: 32

                    // <h1>
                    Text {
                        property string eldurTag: "h1"
                        property string eldurWs: "\n"

                        text: "Tasks"
                        textFormat: Text.PlainText
                        color: "#222222"
                        font.family: EldurFonts.family("Arial, sans-serif")
                        font.pixelSize: 22
                        font.weight: 700
                        lineHeight: EldurFonts.normalLine(font)
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: EldurFonts.shift("Arial, sans-serif", 22, 700, false, 0)
                        }
                        bottomPadding: EldurFonts.slack(font, lineHeight)
                        wrapMode: Text.WordWrap
                        Layout.fillWidth: true
                        renderType: Text.NativeRendering
                    }

                    EldurLines {
                        id: blockFlow
                        property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                        color: "#222222"
                        font.family: EldurFonts.family("Arial, sans-serif")
                        font.pixelSize: 16
                        Layout.fillWidth: true
                        Layout.topMargin: 12
                        Layout.preferredHeight: implicitHeight

                        // <input id="search">
                        Item {
                            implicitWidth: search.implicitWidth
                            width: search.width
                            height: search.height + 12

                            TextField {
                                id: search
                                property var eldurAttrs: ({ "placeholder": "Press Down to enter the list" })
                                property string eldurTag: "input"
                                property string eldurWs: "\n"

                                color: "#000000"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 13
                                verticalAlignment: TextInput.AlignVCenter
                                background: Rectangle {
                                    color: "#ffffff"
                                    radius: 2
                                    border.width: 1
                                    border.color: "#767676"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 6
                                rightPadding: 6
                                bottomPadding: 6
                                leftPadding: 6
                                implicitHeight: 27
                                implicitWidth: 312
                                placeholderText: "Press Down to enter the list"
                                placeholderTextColor: "#757575"
                                objectName: "search"
                                width: 312
                                renderType: Text.NativeRendering

                                Keys.onPressed: (event) => {
                                    event.accepted = !Eldur.fire(search, "keydown", event);
                                }
                                Keys.onReleased: (event) => {
                                    event.accepted = !Eldur.fire(search, "keyup", event);
                                }
                            }
                        }
                    }

                    // <ul id="list">
                    Rectangle {
                        id: list
                        property string eldurTag: "ul"
                        property string eldurWs: "\n"
                        property string eldurWsEnd: "\n"
                        property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : blockFlow.eldurCarry

                        color: "#00000000"
                        implicitWidth: listContent.implicitWidth + 2
                        implicitHeight: listContent.implicitHeight + 2
                        border.width: 1
                        border.color: "#bbbbbb"
                        objectName: "list"
                        Layout.preferredWidth: 322
                        Layout.rightMargin: parent instanceof ColumnLayout ? -Layout.preferredWidth : 0
                        Layout.topMargin: -blockFlow.eldurCarry

                        Keys.onPressed: (event) => {
                            event.accepted = !Eldur.fire(list, "keydown", event);
                        }

                        ColumnLayout {
                            id: listContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.leftMargin: 1
                            anchors.rightMargin: 1
                            anchors.topMargin: 1

                            // <li id="i0">
                            Rectangle {
                                id: i0
                                property var eldurAttrs: ({ "tabindex": "0" })
                                property string eldurTag: "li"
                                property int eldurIndex: 1
                                property int eldurCount: 4
                                property bool cls_picked: false
                                property string eldurWs: "\n"

                                color: i0.activeFocus ? "#dbe9ff" : "#00000000"
                                implicitWidth: i0Text.implicitWidth + 24
                                implicitHeight: i0.eldurIndex === i0.eldurCount ? (i0Text.implicitHeight + 16) : (i0Text.implicitHeight + 17)
                                objectName: "i0"
                                Layout.fillWidth: true
                                activeFocusOnTab: true

                                Rectangle {
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.bottom: parent.bottom
                                    height: i0.eldurIndex === i0.eldurCount ? 0 : 1
                                    color: i0.eldurIndex === i0.eldurCount ? "#00000000" : "#eeeeee"
                                }

                                Text {
                                    id: i0Text
                                    text: "Write the report"
                                    textFormat: Text.PlainText
                                    color: i0.cls_picked ? "#00bb55" : "#222222"
                                    font.family: EldurFonts.family("Arial, sans-serif")
                                    font.pixelSize: 16
                                    lineHeight: EldurFonts.normalLine(font)
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: i0.cls_picked ? EldurFonts.shift("Arial, sans-serif", 16, 700, false, 0) : EldurFonts.shift("Arial, sans-serif", 16, 400, false, 0)
                                    }
                                    bottomPadding: EldurFonts.slack(font, lineHeight)
                                    wrapMode: Text.WordWrap
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.top: parent.top
                                    anchors.leftMargin: 12
                                    anchors.rightMargin: 12
                                    anchors.topMargin: 8
                                    renderType: Text.NativeRendering
                                    font.weight: i0.cls_picked ? 700 : 400
                                }

                                TapHandler {
                                    onTapped: parent.forceActiveFocus()
                                }
                            }

                            // <li id="i1">
                            Rectangle {
                                id: i1
                                property var eldurAttrs: ({ "tabindex": "-1" })
