                                    Layout.fillWidth: true
                                    Layout.topMargin: 24

                                    ColumnLayout {
                                        id: cardContent4
                                        spacing: 0
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                        anchors.leftMargin: 25
                                        anchors.rightMargin: 25
