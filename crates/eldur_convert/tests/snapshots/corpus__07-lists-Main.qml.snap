                                                        font.family: "sans-serif"
                                                        font.pixelSize: 14
                                                        font.weight: 600
                                                        lineHeight: 21
                                                        lineHeightMode: Text.FixedHeight
                                                        transform: Translate {
                                                            y: 2
                                                        }
                                                        wrapMode: Text.WordWrap
                                                        anchors.left: parent.left
                                                        anchors.right: parent.right
                                                        anchors.top: parent.top
                                                        anchors.leftMargin: 14
                                                        anchors.rightMargin: 14
                                                        anchors.topMargin: 6
                                                    }

