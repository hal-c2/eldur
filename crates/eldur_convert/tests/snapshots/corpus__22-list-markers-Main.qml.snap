                                            y: 3
                                        }
                                        wrapMode: Text.WordWrap
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                        anchors.leftMargin: 4
                                        anchors.topMargin: 6
                                        renderType: Text.NativeRendering
                                    }

                                    Rectangle {
                                        x: -16
                                        y: 16
                                        width: 5
                                        height: 5
                                        color: "#1b2231"
                                        radius: 2.5
                                        antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                    }
                                }
                            }
                        }

                        // <ol>
                        Item {
                            implicitWidth: olContent4.implicitWidth + 40
                            implicitHeight: olContent4.implicitHeight
                            Layout.fillWidth: true
                            Layout.topMargin: 16
                            Layout.bottomMargin: 16

                            ColumnLayout {
                                id: olContent4
                                spacing: 0
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.leftMargin: 40

                                // <li>
                                Item {
                                    implicitWidth: liText17.implicitWidth
                                    implicitHeight: liText17.implicitHeight
                                    Layout.fillWidth: true

                                    Text {
                                        id: liText17
                                        text: "after hidden"
                                        textFormat: Text.PlainText
                                        color: "#1b2231"
                                        font.family: "sans-serif"
                                        font.pixelSize: 16
                                        lineHeight: 24
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 3
                                        }
                                        wrapMode: Text.WordWrap
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                        renderType: Text.NativeRendering
                                    }

                                    Text {
                                        text: "1. "
                                        textFormat: Text.PlainText
                                        color: "#1b2231"
                                        font.family: "sans-serif"
                                        font.pixelSize: 16
                                        lineHeight: 24
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 3
                                        }
                                        wrapMode: Text.NoWrap
                                        anchors.right: parent.left
                                        renderType: Text.NativeRendering
                                    }
                                }
                            }
                        }
                    }

                    Item {
                        Layout.fillWidth: true
                    }
                }
            }
        }
    }
}
