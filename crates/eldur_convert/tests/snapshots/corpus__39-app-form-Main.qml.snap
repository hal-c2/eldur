                            wrapMode: Text.WordWrap
                            visible: fName.cls_invalid ? true : (signup.cls_invalid ? true : (body.cls_invalid ? true : page.cls_invalid))
                            Layout.fillWidth: true
                            Layout.topMargin: 3 - blockFlow.eldurCarry
