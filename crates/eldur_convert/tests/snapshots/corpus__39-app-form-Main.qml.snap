                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 16
                            Layout.fillWidth: true
                            Layout.topMargin: 4
                            Layout.preferredHeight: implicitHeight

                            // <input id="name">
                            TextField {
                                id: name
                                property var eldurAttrs: ({ "type": "text", "required": "" })
                                property string eldurTag: "input"
                                property string eldurWs: "\n    "

                                color: "#000000"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 14
                                verticalAlignment: TextInput.AlignVCenter
                                background: Rectangle {
                                    color: fName.cls_invalid ? "#fff5f5" : (signup.cls_invalid ? "#fff5f5" : (body.cls_invalid ? "#fff5f5" : (page.cls_invalid ? "#fff5f5" : "#ffffff")))
                                    radius: 3
                                    border.width: 1
                                    border.color: fName.cls_invalid ? "#cc0000" : (signup.cls_invalid ? "#cc0000" : (body.cls_invalid ? "#cc0000" : (page.cls_invalid ? "#cc0000" : "#999999")))
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 8
                                rightPadding: 8
                                bottomPadding: 8
                                leftPadding: 8
                                implicitHeight: 32
                                implicitWidth: 201.85
                                Accessible.name: "Name"
                                objectName: "name"
                                width: blockFlow.width * 1 + 0
                                renderType: Text.NativeRendering

                                onAccepted: {
                                    Eldur.fire(signup, "submit", null);
                                }
                            }
                        }

                        // <div class="error">
                        Text {
                            id: error
                            property string eldurTag: "div"
                            property string eldurClasses: "error"
