    visible: true
    color: "#ffffff"
    title: "Sign up"
    width: 1280
    height: 800

    Component.onCompleted: {
        Page.__eldur_init(root);
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: page.implicitHeight

        EldurScrollInput {
            id: flickableInput
            scroller: flickable
            keySource: flickable.parent
            focus: true
        }

        // <html>
        ColumnLayout {
            id: page
            property var eldurAttrs: ({ "lang": "en" })
            property string eldurTag: "html"
            property bool cls_invalid: false

            spacing: 0
            width: flickable.width

            // <body>
            ColumnLayout {
                id: body
                property string eldurTag: "body"
                property bool cls_invalid: false
                property string eldurWs: "\n"
                property string eldurWsEnd: "\n\n\n"

                spacing: 0
                Layout.fillWidth: true
                Layout.maximumWidth: Number.POSITIVE_INFINITY
                Layout.leftMargin: 24
                Layout.rightMargin: 24
                Layout.topMargin: 24
                Layout.bottomMargin: 24

                // <h1>
                Text {
                    property string eldurTag: "h1"
                    property string eldurWs: "\n"

                    text: "Create your account"
                    textFormat: Text.PlainText
                    color: "#111111"
                    font.family: EldurFonts.family("Arial, sans-serif")
                    font.pixelSize: 32
                    font.weight: 700
                    lineHeight: EldurFonts.normalLine(font)
                    lineHeightMode: Text.FixedHeight
                    transform: Translate {
                        y: EldurFonts.shift("Arial, sans-serif", 32, 700, false, 0)
                    }
                    bottomPadding: EldurFonts.slack(font, lineHeight)
                    wrapMode: Text.WordWrap
                    Layout.fillWidth: true
                    renderType: Text.NativeRendering
                }

                // <form id="signup">
                ColumnLayout {
                    id: signup
                    property var eldurAttrs: ({ "novalidate": "" })
                    property string eldurTag: "form"
                    property bool cls_invalid: false
                    property string eldurWs: "\n"
                    property string eldurWsEnd: "\n"
                    property real eldurCarry: visible ? (0.56 + blockFlow5.eldurCarry) : 0

                    spacing: 0
                    objectName: "signup"
                    Layout.fillWidth: true
                    Layout.maximumWidth: 380
                    Layout.topMargin: 21.44

                    // <div id="f-name" class="field">
                    ColumnLayout {
                        id: fName
                        property string eldurTag: "div"
                        property string eldurClasses: "field"
                        property bool cls_invalid: false
