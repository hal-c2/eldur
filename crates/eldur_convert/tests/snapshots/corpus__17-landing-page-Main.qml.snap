                                                    onTapped: root.scrollToFragment("#docs")
                                                }

                                                HoverHandler {
                                                    cursorShape: Qt.PointingHandCursor
                                                }
                                            }

                                            // <li>
                                            Text {
                                                id: li10
                                                property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                                text: "Guides"
                                                textFormat: Text.PlainText
                                                color: "#c9cee0"
                                                font.family: "sans-serif"
                                                font.pixelSize: 16
                                                lineHeight: 25.6
                                                lineHeightMode: Text.FixedHeight
                                                transform: Translate {
                                                    y: 4
                                                }
                                                wrapMode: Text.WordWrap
                                                Layout.fillWidth: true
                                                Layout.fillHeight: false
                                                Layout.topMargin: -li9.eldurCarry
                                                renderType: Text.NativeRendering

                                                TapHandler {
                                                    onTapped: root.scrollToFragment("#guides")
                                                }

                                                HoverHandler {
                                                    cursorShape: Qt.PointingHandCursor
                                                }
                                            }

                                            // <li>
                                            Text {
                                                id: li11
                                                property real eldurCarry: Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001

                                                text: "Status"
                                                textFormat: Text.PlainText
                                                color: "#c9cee0"
                                                font.family: "sans-serif"
                                                font.pixelSize: 16
                                                lineHeight: 25.6
                                                lineHeightMode: Text.FixedHeight
                                                transform: Translate {
                                                    y: 4
                                                }
                                                wrapMode: Text.WordWrap
                                                Layout.fillWidth: true
                                                Layout.fillHeight: false
                                                Layout.topMargin: -li10.eldurCarry
                                                renderType: Text.NativeRendering

                                                TapHandler {
                                                    onTapped: root.scrollToFragment("#status")
                                                }

                                                HoverHandler {
                                                    cursorShape: Qt.PointingHandCursor
                                                }
                                            }

                                            // <li>
                                            Text {
                                                id: li12
                                                property real eldurCarry: Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001

                                                text: "Community"
                                                textFormat: Text.PlainText
                                                color: "#c9cee0"
                                                font.family: "sans-serif"
                                                font.pixelSize: 16
                                                lineHeight: 25.6
                                                lineHeightMode: Text.FixedHeight
                                                transform: Translate {
                                                    y: 4
                                                }
                                                wrapMode: Text.WordWrap
                                                Layout.fillWidth: true
                                                Layout.fillHeight: false
                                                Layout.topMargin: -li11.eldurCarry
                                                Layout.preferredHeight: implicitHeight
                                                renderType: Text.NativeRendering

                                                TapHandler {
                                                    onTapped: root.scrollToFragment("#community")
                                                }

                                                HoverHandler {
                                                    cursorShape: Qt.PointingHandCursor
                                                }
                                            }
                                        }
                                    }

                                    Item {
                                        Layout.row: 1
                                        Layout.column: 0
                                        Layout.fillWidth: true
                                        Layout.preferredWidth: 0
                                        Layout.rightMargin: 24
                                    }

                                    Item {
                                        Layout.row: 1
                                        Layout.column: 1
                                        Layout.fillWidth: true
                                        Layout.preferredWidth: 0
                                        Layout.rightMargin: 24
                                    }
                                }

                                // <div class="footer-bottom">
                                Rectangle {
                                    id: footerBottom
                                    property real eldurCarry: Math.ceil(Layout.topMargin - (span.eldurCarry)) - Layout.topMargin + span.eldurCarry + 0.000001

                                    color: "#00000000"
                                    implicitWidth: footerBottomContent.implicitWidth
                                    implicitHeight: footerBottomContent.implicitHeight + 25
                                    Layout.fillWidth: true
                                    Layout.topMargin: 48
                                    Layout.preferredHeight: implicitHeight - span.eldurCarry

                                    Rectangle {
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                        height: 1
                                        color: "#262c44"
                                    }

                                    RowLayout {
                                        id: footerBottomContent
                                        spacing: 0
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                        anchors.bottom: parent.bottom
                                        anchors.topMargin: 25

                                        // <span>
                                        Text {
                                            text: "© 2026 Flowbase, Inc."
                                            textFormat: Text.PlainText
                                            color: "#8b92aa"
                                            font.family: "sans-serif"
                                            font.pixelSize: 14
                                            lineHeight: 23.04
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 3
                                            }
                                            wrapMode: Text.WordWrap
                                            Layout.fillWidth: true
                                            Layout.maximumWidth: Math.ceil(implicitWidth)
                                            Layout.fillHeight: true
                                            renderType: Text.NativeRendering
                                        }

                                        Item {
                                            Layout.fillWidth: true
                                        }

                                        // <span>
                                        Text {
                                            id: span
                                            property real eldurCarry: (h => Math.ceil(h) - h)(Math.max(0, ...Array.from(parent.children).filter(k => k.visible).map(k => k.implicitHeight))) + 0.000001

                                            text: "Privacy · Terms"
                                            textFormat: Text.PlainText
                                            color: "#8b92aa"
                                            font.family: "sans-serif"
                                            font.pixelSize: 14
                                            lineHeight: 23.04
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 3
                                            }
                                            wrapMode: Text.WordWrap
                                            Layout.fillWidth: true
                                            Layout.maximumWidth: Math.ceil(implicitWidth)
                                            Layout.fillHeight: true
                                            renderType: Text.NativeRendering
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
