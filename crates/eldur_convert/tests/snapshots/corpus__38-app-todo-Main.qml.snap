                property string eldurTag: "body"
                property string eldurWs: "\n"
                property string eldurWsEnd: "\n\n\n"

                spacing: 0
                Layout.fillWidth: true
                Layout.maximumWidth: Number.POSITIVE_INFINITY
                Layout.topMargin: 32
                Layout.bottomMargin: 32

                // <div class="app">
                Rectangle {
                    id: app
                    property string eldurTag: "div"
                    property string eldurClasses: "app"
                    property string eldurWs: "\n"
                    property string eldurWsEnd: "\n"
                    property real eldurCarry: visible ? (Math.ceil(Layout.topMargin - (bar.eldurCarry)) - Layout.topMargin + bar.eldurCarry + 0.000001) : 0

                    color: "#ffffff"
                    radius: 6
                    implicitWidth: appContent.implicitWidth + 40
                    implicitHeight: appContent.implicitHeight + 40
                    Layout.preferredWidth: 480
                    Layout.alignment: Qt.AlignHCenter
                    Layout.preferredHeight: implicitHeight - bar.eldurCarry
                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0

                    ColumnLayout {
                        id: appContent
                        spacing: 0
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        anchors.leftMargin: 20
                        anchors.rightMargin: 20
                        anchors.topMargin: 20

                        // <h1>
                        Text {
                            id: h1
                            property string eldurTag: "h1"
                            property string eldurWs: "\n  "
                            property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + Math.ceil(implicitHeight)) - Layout.topMargin - implicitHeight + 0.000001) : 0

                            text: "Todos"
                            textFormat: Text.PlainText
                            color: "#2f855a"
                            font.family: EldurFonts.family("Arial, sans-serif")
                            font.pixelSize: 24
                            font.weight: 700
                            lineHeight: 33.6
                            lineHeightMode: Text.FixedHeight
                            transform: Translate {
                                y: EldurFonts.shift("Arial, sans-serif", 24, 700, false, 33.6)
                            }
                            bottomPadding: EldurFonts.slack(font, lineHeight)
                            wrapMode: Text.WordWrap
                            Layout.fillWidth: true
                            renderType: Text.NativeRendering
                        }

                        // <form id="form">
                        RowLayout {
                            id: form
                            property string eldurTag: "form"
                            property string eldurWs: "\n  "
                            property string eldurWsEnd: "\n  "
                            property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : h1.eldurCarry

                            spacing: 8
                            objectName: "form"
                            Layout.fillWidth: true
                            Layout.maximumWidth: Number.POSITIVE_INFINITY
                            Layout.topMargin: 12 - h1.eldurCarry

                            // <input id="new">
                            TextField {
                                id: new_
                                property var eldurAttrs: ({ "type": "text", "placeholder": "What needs doing?", "autocomplete": "off" })
                                property string eldurTag: "input"
                                property string eldurWs: "\n    "

                                color: "#000000"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 14
                                verticalAlignment: TextInput.AlignVCenter
                                background: Rectangle {
                                    color: "#ffffff"
                                    radius: 4
                                    border.width: 1
                                    border.color: "#cbd5e0"
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 9
                                rightPadding: 9
                                bottomPadding: 9
                                leftPadding: 9
                                implicitHeight: 34
                                implicitWidth: 203.85
                                placeholderText: "What needs doing?"
                                placeholderTextColor: "#757575"
                                objectName: "new"
                                Layout.fillWidth: true
                                Layout.preferredWidth: 0
                                Layout.fillHeight: true
                                renderType: Text.NativeRendering

                                onAccepted: {
                                    Eldur.fire(form, "submit", null);
                                }
                            }

                            // <button id="add">
                            Button {
                                id: add
                                property var eldurAttrs: ({ "type": "submit" })
                                property string eldurTag: "button"
                                property string eldurWs: "\n    "

                                text: "Add"
                                palette.buttonText: "#ffffff"
                                font.family: EldurFonts.family("Arial")
                                font.pixelSize: 13
                                background: Rectangle {
                                    color: "#2f855a"
                                    radius: 4
                                    antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                }
                                topPadding: 8
                                rightPadding: 12
                                bottomPadding: 8
                                leftPadding: 12
                                implicitHeight: 31
                                contentItem: Text {
                                    text: add.text
                                    font: add.font
                                    color: add.palette.buttonText
                                    horizontalAlignment: Text.AlignHCenter
                                    verticalAlignment: Text.AlignVCenter
                                    renderType: Text.NativeRendering
                                }
                                implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                objectName: "add"
                                Layout.fillWidth: true
                                Layout.maximumWidth: implicitWidth
                                Layout.fillHeight: true

                                onClicked: {
                                    Eldur.fire(form, "submit", null);
                                }
                            }
                        }

                        // <ul id="list">
                        Item {
                            id: list
                            property string eldurTag: "ul"
                            property string eldurWs: "\n  "
                            property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : form.eldurCarry

                            implicitWidth: Math.max(listText.implicitWidth, ulFlow.implicitWidth) + 0
                            implicitHeight: (listText.text === "" ? 0 : listText.implicitHeight) + ulFlow.implicitHeight + 0
                            objectName: "list"
                            Layout.fillWidth: true
                            Layout.topMargin: 12 - form.eldurCarry
                            Layout.preferredHeight: implicitHeight

                            Text {
                                id: listText
                                text: ""
                                textFormat: Text.PlainText
                                color: "#000000"
                                font.family: EldurFonts.family("Arial, sans-serif")
                                font.pixelSize: 16
                                lineHeight: 22.4
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: EldurFonts.shift("Arial, sans-serif", 16, 400, false, 22.4)
                                }
                                bottomPadding: EldurFonts.slack(font, lineHeight)
                                wrapMode: Text.WordWrap
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                visible: text !== ""
                                renderType: Text.NativeRendering
                            }

                            ColumnLayout {
                                id: ulFlow
                                spacing: 0
                                x: 0
                                y: (listText.text === "" ? 0 : listText.implicitHeight) + 0
                                width: parent.width - 0
                            }
                        }

                        // <div class="bar">
                        RowLayout {
                            id: bar
                            property string eldurTag: "div"
                            property string eldurClasses: "bar"
                            property string eldurWs: "\n  "
                            property string eldurWsEnd: "\n  "
                            property real eldurCarry: visible ? (Math.ceil(Layout.topMargin + implicitHeight) - Layout.topMargin - implicitHeight + 0.000001) : list.eldurCarry

                            spacing: 0
                            Layout.fillWidth: true
                            Layout.maximumWidth: Number.POSITIVE_INFINITY
                            Layout.topMargin: 12 - list.eldurCarry

                            // <span id="count">
                            Text {
                                id: count
                                property string eldurTag: "span"
                                property string eldurWs: "\n    "

                                text: ""
                                textFormat: Text.PlainText
                                color: "#4a5568"
                                font.family: EldurFonts.family("Arial, sans-serif")
                                font.pixelSize: 13
                                lineHeight: 18.2
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: EldurFonts.shift("Arial, sans-serif", 13, 400, false, 18.2)
                                }
                                bottomPadding: EldurFonts.slack(font, lineHeight)
                                wrapMode: Text.WordWrap
                                objectName: "count"
                                Layout.preferredHeight: text === "" ? 0 : -1
                                Layout.fillWidth: true
                                Layout.maximumWidth: Math.ceil(implicitWidth)
                                Layout.alignment: Qt.AlignVCenter
                                renderType: Text.NativeRendering
                            }

                            Item {
                                Layout.fillWidth: true
                            }

                            // <div class="filters">
                            Item {
                                id: filters
                                property string eldurTag: "div"
                                property string eldurClasses: "filters"
                                property string eldurWs: "\n    "
                                property string eldurWsEnd: "\n    "

                                implicitWidth: filtersFlow.implicitWidth
                                implicitHeight: filtersFlow.implicitHeight
                                Layout.fillWidth: true
                                Layout.maximumWidth: Math.ceil(implicitWidth)
                                Layout.alignment: Qt.AlignVCenter

                                EldurLines {
                                    id: filtersFlow
                                    color: "#4a5568"
                                    font.family: EldurFonts.family("Arial, sans-serif")
                                    font.pixelSize: 13
                                    lineHeight: 18.2
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.top: parent.top

                                    // <button id="f-all" class="current">
                                    Button {
                                        id: fAll
                                        property var eldurAttrs: ({ "data-filter": "all" })
                                        property string eldurTag: "button"
                                        property string eldurClasses: "current"
                                        property bool cls_current: true
                                        property string eldurWs: "\n      "

                                        text: "All"
                                        palette.buttonText: fAll.cls_current ? "#2f855a" : "#000000"
                                        font.family: EldurFonts.family("Arial")
                                        font.pixelSize: 13
                                        background: Rectangle {
                                            color: "#00000000"
                                            radius: 3
                                            border.width: 1
                                            border.color: fAll.cls_current ? "#2f855a" : "#00000000"
                                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                        }
                                        topPadding: 3
                                        rightPadding: 7
                                        bottomPadding: 3
                                        leftPadding: 7
                                        implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                                        contentItem: Text {
                                            text: fAll.text
                                            font: fAll.font
                                            color: fAll.palette.buttonText
                                            horizontalAlignment: Text.AlignHCenter
                                            verticalAlignment: Text.AlignVCenter
                                            wrapMode: Text.WordWrap
                                            renderType: Text.NativeRendering
                                        }
                                        implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                        objectName: "f-all"
                                        width: Math.min(implicitWidth, Math.max(filtersFlow.width, Math.ceil(Math.max(...fAll.text.split(/\s+/).map(w => fAllWords.advanceWidth(w))) * 1.0256385) + leftPadding + rightPadding))

                                        FontMetrics {
                                            id: fAllWords
                                            font: fAll.font
                                        }
                                    }

                                    EldurRun {
                                        text: " "
                                        color: "#4a5568"
                                        font.family: "Arial, sans-serif"
                                        font.pixelSize: 13
                                    }

                                    // <button id="f-active">
                                    Button {
                                        id: fActive
                                        property var eldurAttrs: ({ "data-filter": "active" })
                                        property string eldurTag: "button"
                                        property bool cls_current: false
                                        property string eldurWs: "\n      "

                                        text: "Active"
                                        palette.buttonText: fActive.cls_current ? "#2f855a" : "#000000"
                                        font.family: EldurFonts.family("Arial")
                                        font.pixelSize: 13
                                        background: Rectangle {
                                            color: "#00000000"
                                            radius: 3
                                            border.width: 1
                                            border.color: fActive.cls_current ? "#2f855a" : "#00000000"
                                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                        }
                                        topPadding: 3
                                        rightPadding: 7
                                        bottomPadding: 3
                                        leftPadding: 7
                                        implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                                        contentItem: Text {
                                            text: fActive.text
                                            font: fActive.font
                                            color: fActive.palette.buttonText
                                            horizontalAlignment: Text.AlignHCenter
                                            verticalAlignment: Text.AlignVCenter
                                            wrapMode: Text.WordWrap
                                            renderType: Text.NativeRendering
                                        }
                                        implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                        objectName: "f-active"
                                        width: Math.min(implicitWidth, Math.max(filtersFlow.width, Math.ceil(Math.max(...fActive.text.split(/\s+/).map(w => fActiveWords.advanceWidth(w))) * 1.0256385) + leftPadding + rightPadding))

                                        FontMetrics {
                                            id: fActiveWords
                                            font: fActive.font
                                        }
                                    }

                                    EldurRun {
                                        text: " "
                                        color: "#4a5568"
                                        font.family: "Arial, sans-serif"
                                        font.pixelSize: 13
                                    }

                                    // <button id="f-done">
                                    Button {
                                        id: fDone
                                        property var eldurAttrs: ({ "data-filter": "done" })
                                        property string eldurTag: "button"
                                        property bool cls_current: false
                                        property string eldurWs: "\n      "

                                        text: "Done"
                                        palette.buttonText: fDone.cls_current ? "#2f855a" : "#000000"
                                        font.family: EldurFonts.family("Arial")
                                        font.pixelSize: 13
                                        background: Rectangle {
                                            color: "#00000000"
                                            radius: 3
                                            border.width: 1
                                            border.color: fDone.cls_current ? "#2f855a" : "#00000000"
                                            antialiasing: Math.round(x * 64) % 64 === 0 && Math.round(y * 64) % 64 === 0 && Math.round(width * 64) % 64 === 0 && Math.round(height * 64) % 64 === 0
                                        }
                                        topPadding: 3
                                        rightPadding: 7
                                        bottomPadding: 3
                                        leftPadding: 7
                                        implicitHeight: topPadding + bottomPadding + Math.max(1, contentItem.lineCount) * 15
                                        contentItem: Text {
                                            text: fDone.text
                                            font: fDone.font
                                            color: fDone.palette.buttonText
                                            horizontalAlignment: Text.AlignHCenter
                                            verticalAlignment: Text.AlignVCenter
                                            wrapMode: Text.WordWrap
                                            renderType: Text.NativeRendering
                                        }
                                        implicitWidth: contentItem.implicitWidth * 1.0256385 + leftPadding + rightPadding
                                        objectName: "f-done"
                                        width: Math.min(implicitWidth, Math.max(filtersFlow.width, Math.ceil(Math.max(...fDone.text.split(/\s+/).map(w => fDoneWords.advanceWidth(w))) * 1.0256385) + leftPadding + rightPadding))

                                        FontMetrics {
                                            id: fDoneWords
                                            font: fDone.font
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // <template id="row">
                Text {
                    id: row
                    property string eldurTag: "template"
                    property string eldurWs: "\n"

                    text: ""
                    textFormat: Text.PlainText
                    color: "#000000"
                    font.family: EldurFonts.family("Arial, sans-serif")
                    font.pixelSize: 16
                    lineHeight: 22.4
                    lineHeightMode: Text.FixedHeight
                    transform: Translate {
                        y: EldurFonts.shift("Arial, sans-serif", 16, 400, false, 22.4)
                    }
                    bottomPadding: EldurFonts.slack(font, lineHeight)
                    wrapMode: Text.WordWrap
                    objectName: "row"
                    visible: false
                    Layout.preferredHeight: text === "" ? 0 : -1
                    Layout.fillWidth: true
                    Layout.topMargin: 32 - app.eldurCarry
                    renderType: Text.NativeRendering
                }
            }
        }

        Item {
            id: initialContainingBlock
            width: flickable.width
            height: flickable.height
        }
    }
}
