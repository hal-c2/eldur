                            width: Math.min(implicitWidth, centeredFlow.width)

                            Text {
                                id: buttonText2
                                text: "Read the docs"
                                textFormat: Text.PlainText
                                color: "#2563eb"
                                font.family: "Liberation Sans"
                                font.pixelSize: 16
                                font.weight: 700
                                lineHeight: 24
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 2.8
                                }
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.leftMargin: 22
                                anchors.rightMargin: 22
                                anchors.topMargin: 12
                            }
                        }
                    }
                }

                // <section>
                Flow {
                    id: sectionFlow
                    Layout.fillWidth: true
                    Layout.topMargin: 24

                    Text {
                        text: "Status: "
                        textFormat: Text.PlainText
                        color: "#1b2231"
                        font.family: "Liberation Sans"
                        font.pixelSize: 16
                        lineHeight: 24
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: 2.8
                        }
                        topPadding: 1.34
                    }

                    Rectangle {
                        color: "#dcfce7"
                        radius: 999
                        implicitWidth: chipContent.implicitWidth + 24
                        implicitHeight: chipContent.implicitHeight + 8
                        width: Math.min(implicitWidth, sectionFlow.width)

                        RowLayout {
                            id: chipContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.bottom: parent.bottom
                            anchors.leftMargin: 12
                            anchors.rightMargin: 12
                            anchors.topMargin: 4
                            anchors.bottomMargin: 4

                            // <span class="dot">
                            Rectangle {
                                color: "#16a34a"
                                radius: 4
                                implicitWidth: 0
                                implicitHeight: 0
                                Layout.fillWidth: true
                                Layout.preferredWidth: 8
                                Layout.maximumWidth: 8
                                Layout.preferredHeight: 8
                                Layout.alignment: Qt.AlignVCenter
                            }

                            Text {
                                text: "Online"
                                textFormat: Text.PlainText
                                color: "#166534"
                                font.family: "Liberation Sans"
                                font.pixelSize: 14
                                lineHeight: 20
                                lineHeightMode: Text.FixedHeight
                                transform: Translate {
                                    y: 1.95
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                Layout.maximumWidth: Math.ceil(implicitWidth)
                                Layout.alignment: Qt.AlignVCenter
                                Layout.leftMargin: 6
                            }

                            Item {
                                Layout.fillWidth: true
                            }
                        }
                    }

                    Text {
                        text: " "
                        textFormat: Text.PlainText
                        color: "#1b2231"
                        font.family: "Liberation Sans"
                        font.pixelSize: 16
                        lineHeight: 24
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: 2.8
                        }
                        topPadding: 1.34
                    }

                    Text {
                        text: "since "
                        textFormat: Text.PlainText
                        color: "#1b2231"
                        font.family: "Liberation Sans"
                        font.pixelSize: 16
                        lineHeight: 24
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: 2.8
                        }
                        topPadding: 1.34
                    }

                    Text {
                        text: "Monday."
                        textFormat: Text.PlainText
                        color: "#1b2231"
                        font.family: "Liberation Sans"
                        font.pixelSize: 16
                        lineHeight: 24
                        lineHeightMode: Text.FixedHeight
                        transform: Translate {
                            y: 2.8
                        }
                        topPadding: 1.34
                    }
                }

                // <section>
                Flow {
                    id: sectionFlow2
                    Layout.fillWidth: true
                    Layout.topMargin: 24

                    Item {
                        width: statBox.width + 16
                        height: statBox.height

                        Rectangle {
                            id: statBox
                            color: "#fef3c7"
                            radius: 8
                            implicitWidth: statContent.implicitWidth + 24
                            implicitHeight: statContent.implicitHeight + 24
                            width: 164

                            ColumnLayout {
                                id: statContent
                                spacing: 0
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.leftMargin: 12
                                anchors.rightMargin: 12
                                anchors.topMargin: 12

                                // <div>
                                Text {
                                    text: "42"
                                    textFormat: Text.PlainText
                                    color: "#1b2231"
                                    font.family: "Liberation Sans"
                                    font.pixelSize: 28
                                    font.weight: 700
                                    lineHeight: 32
                                    lineHeightMode: Text.FixedHeight
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                }

                                Text {
                                    text: "<font color=\"#92400e\"><small>open issues</small></font>"
                                    textFormat: Text.StyledText
                                    color: "#1b2231"
                                    font.family: "Liberation Sans"
                                    font.pixelSize: 16
                                    lineHeight: 24
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 2.8
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                }
                            }
                        }
                    }

                    Item {
                        width: statBox2.width + 16
                        height: statBox2.height

                        Rectangle {
                            id: statBox2
                            color: "#fef3c7"
                            radius: 8
                            implicitWidth: statContent2.implicitWidth + 24
                            implicitHeight: statContent2.implicitHeight + 24
                            width: 164

                            ColumnLayout {
                                id: statContent2
                                spacing: 0
                                anchors.left: parent.left
                                anchors.right: parent.right
                                anchors.top: parent.top
                                anchors.leftMargin: 12
                                anchors.rightMargin: 12
                                anchors.topMargin: 12

                                // <div>
                                Text {
                                    text: "7"
                                    textFormat: Text.PlainText
                                    color: "#1b2231"
                                    font.family: "Liberation Sans"
                                    font.pixelSize: 28
                                    font.weight: 700
                                    lineHeight: 32
                                    lineHeightMode: Text.FixedHeight
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                }

                                Text {
                                    text: "<font color=\"#92400e\"><small>releases</small></font>"
                                    textFormat: Text.StyledText
                                    color: "#1b2231"
                                    font.family: "Liberation Sans"
                                    font.pixelSize: 16
                                    lineHeight: 24
                                    lineHeightMode: Text.FixedHeight
                                    transform: Translate {
                                        y: 2.8
                                    }
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
