// Generated by html-2-qml from index.html. Do not edit.

import QtQuick
import QtQuick.Controls.Basic
import QtQuick.Layouts
import "h2q_runtime.js" as H2Q
import "page.js" as Page

ApplicationWindow {
    id: root
    visible: true
    color: "#eef1f7"
    title: "Todo List"
    width: 1280
    height: 800

    Component.onCompleted: {
        Page.__h2q_init(root);
    }

    Flickable {
        id: flickable
        anchors.fill: parent
        contentWidth: width
        boundsBehavior: Flickable.StopAtBounds
        ScrollBar.vertical: ScrollBar {}
        contentHeight: page.implicitHeight

        // <html>
        ColumnLayout {
            id: page
            spacing: 0
            width: flickable.width

            // <body>
            Item {
                implicitWidth: bodyContent.implicitWidth + 32
                implicitHeight: bodyContent.implicitHeight + 96
                Layout.fillWidth: true

                ColumnLayout {
                    id: bodyContent
                    spacing: 0
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: parent.top
                    anchors.leftMargin: 16
                    anchors.rightMargin: 16
                    anchors.topMargin: 48

                    // <main class="app">
                    Rectangle {
                        color: "#ffffff"
                        radius: 16
                        implicitWidth: appContent.implicitWidth + 56
                        implicitHeight: appContent.implicitHeight + 56
                        Layout.fillWidth: true
                        Layout.alignment: Qt.AlignHCenter
                        Layout.maximumWidth: 560

                        ColumnLayout {
                            id: appContent
                            spacing: 0
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.leftMargin: 28
                            anchors.rightMargin: 28
                            anchors.topMargin: 28

                            // <header class="app-header">
                            RowLayout {
                                spacing: 0
                                Layout.fillWidth: true
                                Layout.maximumWidth: Number.POSITIVE_INFINITY

                                // <h1>
                                Text {
                                    text: "Today"
                                    textFormat: Text.PlainText
                                    color: "#3a4256"
                                    font.family: "sans-serif"
                                    font.pixelSize: 24
                                    font.weight: 700
                                    wrapMode: Text.WordWrap
                                    Layout.fillWidth: true
                                    Layout.maximumWidth: Math.ceil(implicitWidth)
                                    Layout.alignment: Qt.AlignBaseline
                                }

                                Item {
                                    Layout.fillWidth: true
                                }

                                // <p id="counter" class="counter">
                                Text {
                                    id: counter
                                    text: "0 items left"
                                    textFormat: Text.PlainText
                                    color: "#6b7280"
                                    font.family: "sans-serif"
                                    font.pixelSize: 14
                                    wrapMode: Text.WordWrap
                                    objectName: "counter"
                                    Layout.fillWidth: true
                                    Layout.maximumWidth: Math.ceil(implicitWidth)
                                    Layout.alignment: Qt.AlignBaseline
                                }
                            }

                            // <div class="composer">
                            RowLayout {
                                spacing: 8
                                Layout.fillWidth: true
                                Layout.maximumWidth: Number.POSITIVE_INFINITY
                                Layout.topMargin: 20

                                // <input id="todo-input">
                                Item {
                                    id: todoInput
                                    objectName: "todo-input"
                                    Layout.fillWidth: true
                                    Layout.preferredWidth: 0
                                    Layout.fillHeight: true
                                }

                                // <button id="add-btn" class="btn">
                                Rectangle {
                                    id: addBtn
                                    color: "#1d4ed8"
                                    radius: 8
                                    implicitWidth: addBtnText.implicitWidth + 36
                                    implicitHeight: addBtnText.implicitHeight + 20
                                    objectName: "add-btn"
                                    Layout.fillWidth: true
                                    Layout.maximumWidth: Math.ceil(implicitWidth)
                                    Layout.fillHeight: true

                                    Text {
                                        id: addBtnText
                                        text: "Add"
                                        textFormat: Text.PlainText
                                        color: "#ffffff"
                                        font.family: "sans-serif"
                                        font.pixelSize: 16
                                        font.weight: 600
                                        horizontalAlignment: Text.AlignHCenter
                                        wrapMode: Text.WordWrap
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.top: parent.top
                                        anchors.leftMargin: 18
                                        anchors.rightMargin: 18
                                        anchors.topMargin: 10
                                    }

                                    TapHandler {
                                        onTapped: (eventPoint, button) => {
                                            Page.__h2q_on_click_addBtn(H2Q.event("click", addBtn, eventPoint));
                                        }
                                    }
                                }
                            }

                            // <ul id="todo-list" class="todo-list">
                            Rectangle {
                                id: todoList
                                color: "#00000000"
                                implicitWidth: todoListText.implicitWidth
                                implicitHeight: todoListText.implicitHeight + 1
                                objectName: "todo-list"
                                Layout.fillWidth: true
                                Layout.topMargin: 20

                                Rectangle {
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.top: parent.top
                                    height: 1
                                    color: "#e3e7ef"
                                }

                                Text {
                                    id: todoListText
                                    text: ""
                                    textFormat: Text.PlainText
                                    color: "#1f2430"
                                    font.family: "sans-serif"
                                    font.pixelSize: 16
                                    wrapMode: Text.WordWrap
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.top: parent.top
                                    anchors.topMargin: 1
                                }
                            }

                            // <p id="empty" class="empty">
                            Text {
                                id: empty
                                text: "Nothing here yet."
                                textFormat: Text.PlainText
                                color: "#1f2430"
                                font.family: "sans-serif"
                                font.pixelSize: 16
                                wrapMode: Text.WordWrap
                                objectName: "empty"
                                visible: false
                                Layout.fillWidth: true
                            }

                            // <p class="footer-note">
                            Text {
                                text: "Saved in this browser."
                                textFormat: Text.PlainText
                                color: "#9aa3b5"
                                font.family: "sans-serif"
                                font.pixelSize: 12
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                                Layout.topMargin: 24
