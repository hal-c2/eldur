                        // <p class="lead">
                        Text {
                            text: "Every few years our team felt the same itch: the build was slow, the configuration had grown brittle, and someone had found a newer tool that promised to fix everything. We rewrote it three times before we understood the real problem."
                            textFormat: Text.PlainText
                            color: "#3a3731"
                            font.family: "serif"
