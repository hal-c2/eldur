                                            color: "#6e675e"
                                            font.family: "serif"
                                            font.pixelSize: 14
                                            lineHeight: 20.4
                                            lineHeightMode: Text.FixedHeight
                                            transform: Translate {
                                                y: 2.38
                                            }
                                            wrapMode: Text.WordWrap
                                            Layout.fillWidth: true
                                            Layout.topMargin: 6
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
