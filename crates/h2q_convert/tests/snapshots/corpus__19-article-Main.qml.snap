                                    y: 5.7
                                }
                                wrapMode: Text.WordWrap
                                Layout.fillWidth: true
                            }

                            // <p>
                            Text {
                                text: "The second rewrite replaced the orchestrator with a faster one. Builds dropped from eleven minutes to four, and everyone celebrated. Six months later, the cache was returning stale artifacts for about one change in fifty, and nobody could say which change."
                                textFormat: Text.PlainText
                                color: "#1f1d1a"
                                font.family: "serif"
                                font.pixelSize: 19
                                lineHeight: 33.25
                                lineHeightMode: Text.FixedHeight
