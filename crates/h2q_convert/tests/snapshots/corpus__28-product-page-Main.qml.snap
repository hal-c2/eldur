                                            implicitHeight: 16
                                            background: Rectangle {
                                                color: "#efefef"
                                                radius: 3
                                            }
                                            contentItem: Item {
                                                Rectangle {
                                                    width: meterControl2.visualPosition * parent.width
                                                    height: parent.height
                                                    radius: 3
                                                    color: meterControl2.value < 2 ? "#d13438" : (meterControl2.value > 4 ? "#107c10" : "#ffb900")
                                                }
                                            }
                                            Layout.fillWidth: true
                                            Layout.preferredWidth: 100
                                            Layout.maximumWidth: 100
                                            Layout.alignment: Qt.AlignVCenter
                                            Layout.leftMargin: 12
                                        }

                                        Item {
                                            Layout.fillWidth: true
                                        }
                                    }

                                    // <p>
                                    Text {
                                        text: "Good kettle, but the lid gets hot. Use a cloth."
                                        textFormat: Text.PlainText
                                        color: "#3d4650"
                                        font.family: "sans-serif"
                                        font.pixelSize: 15
                                        lineHeight: 22.5
                                        lineHeightMode: Text.FixedHeight
                                        transform: Translate {
                                            y: 2.63
                                        }
                                        wrapMode: Text.WordWrap
                                        Layout.fillWidth: true
                                        Layout.topMargin: 6
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
