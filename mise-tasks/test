#!/usr/bin/env bash
#MISE description="All Rust tests (the end-to-end tests that run QML in Qt 6's qmltestrunner skip, saying so, when Qt 6 is missing, unless ELDUR_REQUIRE_QT=1, which makes them fail)"
#USAGE arg "[cargo_args]..." var=#true help="Passed to cargo test, e.g. -p eldur_css; mise eats the first --, so test binary flags need two: mise run test -- -p eldur_css -- --nocapture"
set -euo pipefail
task_name="test"
# shellcheck source=mise-tasks/_lib/common.sh
. "$(dirname "$0")/_lib/common.sh"
cd "$root"
# A skipped test passes, so the skip is said once here, where it is seen.
# QMLTESTRUNNER is exported so the tests take the runner this found.
if runner="$(qt6_tool qmltestrunner)" && [[ -n "$runner" ]]; then
  export QMLTESTRUNNER="$runner"
else
  # CI's Qt job sets ELDUR_REQUIRE_QT=1: there a missing runner is a failure,
  # never a green run of skipped tests.
  case "${ELDUR_REQUIRE_QT:-}" in
    "" | 0) ;;
    *) die "ELDUR_REQUIRE_QT is set but Qt 6's qmltestrunner was not found (set QMLTESTRUNNER, or $qt6_install_hint)" ;;
  esac
  echo "test: Qt 6's qmltestrunner not found, so the end-to-end tests that run QML skip (set QMLTESTRUNNER, or $qt6_install_hint)" >&2
fi
# No --workspace by default: the root is a virtual workspace, so a bare run
# already tests every member, and -p in cargo_args can then pick one. Cargo
# only takes --exclude together with --workspace, so it is added then, unless
# the caller already wrote --workspace (or its alias --all).
has_exclude=false
has_ws=false
for a in "$@"; do
  [[ "$a" == "--" ]] && break
  case "$a" in
    --exclude | --exclude=*) has_exclude=true ;;
    --workspace | --all) has_ws=true ;;
  esac
done
args=()
[[ "$has_exclude" == true && "$has_ws" == false ]] && args=(--workspace)
cargo test ${args[@]+"${args[@]}"} "$@"
