#!/usr/bin/env bash
#MISE description="All Rust tests"
#USAGE arg "[cargo_args]..." var=#true help="Passed to cargo test, e.g. -p eldur_css; mise eats the first --, so test binary flags need two: mise run test -- -p eldur_css -- --nocapture"
set -euo pipefail
# No --workspace: the root is a virtual workspace, so a bare run already tests
# every member, and -p in cargo_args can then pick one.
cargo test "$@"
