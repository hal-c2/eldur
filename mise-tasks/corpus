#!/usr/bin/env bash
#MISE description="Convert every tests/corpus case into target/corpus/<case>/ (then: mise run qml:check target/corpus)"
#USAGE arg "[out]" default="target/corpus" help="Directory each case's QML is written under"
set -euo pipefail
out="${usage_out:-target/corpus}"
cargo build -q -p eldur_cli
for dir in tests/corpus/*/; do
  case=$(basename "$dir")
  rm -rf "${out:?}/$case"
  cargo run -q -p eldur_cli -- convert -q "$dir/index.html" -o "$out/$case" 2>/dev/null
done
