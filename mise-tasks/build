#!/usr/bin/env bash
#MISE description="Build every crate, and the eldur binary (its path is printed at the end)"
#USAGE flag "--release" help="Optimised build"
set -euo pipefail
task_name="build"
# shellcheck source=mise-tasks/_lib/common.sh
. "$(dirname "$0")/_lib/common.sh"
cd "$root"
release=()
[[ "${usage_release:-false}" == "true" ]] && release=(--release)
cargo build --workspace --locked ${release[@]+"${release[@]}"}
# Asked of cargo, which knows where a build target or profile puts it; the
# build above already made it, so this builds nothing.
echo "build: eldur is $(build_eldur ${release[@]+"${release[@]}"})"
