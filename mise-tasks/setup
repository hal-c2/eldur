#!/usr/bin/env bash
#MISE description="First run: install the pinned toolchain, fetch crates, and say which optional tools are missing (idempotent)"
#USAGE flag "--offline" help="Skip cargo fetch (use crates already in the cargo cache)"
#USAGE flag "--check" help="Install and fetch nothing; report what is found, and fail if Rust or Qt is not the pinned version"
set -euo pipefail
task_name="setup"
# shellcheck source=mise-tasks/_lib/common.sh
. "$(dirname "$0")/_lib/common.sh"
cd "$root"

check="${usage_check:-false}"
done_steps=()
skipped=()
mismatched=()

# mise installs mise.toml's Rust through rustup; without it `mise install`
# fails with a message about the backend, not about what to install.
command -v rustup >/dev/null 2>&1 ||
  die "rustup not found: mise installs mise.toml's Rust through it; install rustup (https://rustup.rs, or your package manager's rustup), then mise run setup again"
if [ "$check" = true ]; then
  done_steps+=("--check: nothing installed or fetched")
else
  mise install
  done_steps+=("mise install: Rust $(mise exec -- rustc --version | cut -d' ' -f2) with rustfmt and clippy (mise.toml)")
fi

# mise.toml's activate_aggressive puts rustup's proxies first on PATH, so
# tasks build with the pinned Rust even with a system Rust installed. If a
# task's rustc is still another version (`mise exec -- rustc` would find the
# pin either way, so PATH is asked), every build differs from CI's: setup
# fails and says how to fix it.
pinned="${RUSTUP_TOOLCHAIN:-}"
wrong_rust=""
if ! command -v rustc >/dev/null 2>&1; then
  have=""
  wrong_rust="rustc not found on PATH: mise run setup installs mise.toml's Rust"
else
  have="$(rustc --version | cut -d' ' -f2)"
fi
if [ -n "$pinned" ] && [ -n "$have" ] && [ "$have" != "$pinned" ]; then
  wrong_rust="rustc on PATH is $have ($(command -v rustc)), not mise.toml's $pinned: tasks build with it; put rustup's ~/.cargo/bin before it, or remove the system Rust"
fi

if [ "$check" != true ]; then
  if [[ -f .gitmodules ]]; then
    git submodule update --init --recursive
    done_steps+=("git submodules initialised")
  fi
  if [[ "${usage_offline:-false}" == "true" ]]; then
    skipped+=("cargo fetch: --offline")
  else
    mise exec -- cargo fetch --locked
    done_steps+=("cargo fetch --locked: every crate in Cargo.lock downloaded")
  fi
fi

# Optional tools are found on PATH, never installed: they are system packages
# or the user's choice, and the converter itself needs none of them.
have() { command -v "$1" >/dev/null 2>&1; }
qmllint="$(qt6_tool qmllint)"
runner="$(qt6_tool qmltestrunner)"
if have qml6 && [ -n "$qmllint" ] && [ -n "$runner" ]; then
  done_steps+=("Qt 6 found: qml6 ($(command -v qml6)), qmllint ($qmllint), qmltestrunner ($runner)")
else
  skipped+=("Qt 6 (qml6, qmllint, qmltestrunner) not all found: mise run qml:check and mise run dev with qml6 won't work, and mise run test skips the end-to-end tests that run QML; $qt6_install_hint")
fi
while IFS= read -r line; do
  mismatched+=("$line")
done < <(qt_pin_mismatches)
if have ljos; then
  done_steps+=("ljos found: mise run dev runs pages in Ljós ($(command -v ljos))")
else
  skipped+=("ljos not found: mise run dev uses qml6 instead; install it with mise run install in a ljos-ui checkout")
fi
if have python3 && have node; then
  done_steps+=("python3 and node found (visual harness)")
else
  skipped+=("python3 or node not found: mise run visual won't run")
fi
if have playwright || node -e 'require.resolve("playwright")' >/dev/null 2>&1; then
  done_steps+=("Playwright found (visual harness renders the HTML side in Chromium)")
else
  skipped+=("Playwright not found: mise run visual needs it; mise use -g npm:playwright, then playwright install chromium")
fi
if have sway; then
  done_steps+=("sway found (visual harness default GL backend)")
else
  skipped+=("sway not found: mise run visual needs --backend software without it")
fi

echo
if [ "$check" = true ]; then
  echo "setup --check:"
  done_steps+=("rustc ${have:-missing} on PATH; mise.toml pins ${pinned:-(RUSTUP_TOOLCHAIN unset)}")
else
  echo "setup done:"
fi
printf '  - %s\n' "${done_steps[@]}"
if ((${#skipped[@]})); then
  echo "skipped:"
  printf '  - %s\n' "${skipped[@]}"
fi
if ((${#mismatched[@]})); then
  echo "not the pinned version:"
  printf '  - %s\n' "${mismatched[@]}"
fi
echo
if [ -n "$wrong_rust" ]; then
  die "$wrong_rust"
fi
# Qt is optional, so plain setup only reports a Qt of another minor; --check
# is the question "is this machine what CI and the specs assume?".
if [ "$check" = true ] && ((${#mismatched[@]})); then
  die "${mismatched[0]}"
fi
echo "next: mise run dev   (convert a sample page and run it)"
