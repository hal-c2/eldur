#!/usr/bin/env bash
#MISE description="Test the tasks' own logic with stand-in tools: setup and setup --check against the pinned Qt and the next minor"
set -euo pipefail
task_name="tasks:test"
# shellcheck source=mise-tasks/_lib/common.sh
. "$(dirname "$0")/../_lib/common.sh"
cd "$root"

scratch="$(mktemp -d "${TMPDIR:-/tmp}/eldur-tasks-test.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
scratch="$(cd "$scratch" && pwd -P)"

# PATH holds only the stand-ins and the few system commands setup calls, so
# the machine's own Rust and optional tools never answer for them. qt6_tool
# also looks in distributions' Qt directories, so every case names the
# qmltestrunner and qmllint it means, through PATH or QMLTESTRUNNER/QMLLINT.
sys="$scratch/sys"
mkdir -p "$sys"
for cmd in bash cut dirname readlink tr; do
  ln -s "$(command -v "$cmd")" "$sys/$cmd"
done

# The stand-ins follow the pin, so moving it needs no change here.
newer="6.$((${qt_pinned#6.} + 1))"

# `stub <dir> <name> <output>`: a tool that prints <output> and succeeds.
stub() {
  mkdir -p "$scratch/$1"
  printf '#!/bin/sh\necho "%s"\n' "$3" >"$scratch/$1/$2"
  chmod +x "$scratch/$1/$2"
}
# `distro <dir> <version>`: Qt 6's tools as a distribution names them.
distro() {
  stub "$1" qmake6 "$2"
  stub "$1" qml6 "Qml Runtime $2"
  stub "$1" qmllint6 "qmllint $2"
  stub "$1" qmltestrunner6 "Unknown option: '--version'"
}
# `installer <dir> <version>`: Qt's own bin directory, with plain names.
installer() {
  stub "$1" qtpaths "$2"
  stub "$1" qml "Qml Runtime $2"
  stub "$1" qmllint "qmllint $2"
  stub "$1" qmltestrunner "Unknown option: '--version'"
}

failed=0
# `expect <case> <exit code> <text> [NAME=value...]`: setup --check, with
# <case>'s tools first on PATH and the variables given, exits with <exit
# code> and prints <text>, or prints no note on Qt when <text> is empty. Qt
# is only the reference, so no Qt it finds fails setup.
expect() {
  local case="$1" want="$2" text="$3" out code=0
  shift 3
  out="$(env -i HOME="$scratch" PATH="$scratch/$case:$sys" RUSTUP_TOOLCHAIN=1.98.1 \
    usage_check=true "$@" bash mise-tasks/setup 2>&1)" || code=$?
  if [ "$code" != "$want" ] || { [ -n "$text" ] && [[ "$out" != *"$text"* ]]; } ||
    { [ -z "$text" ] && [[ "$out" == *"note, a Qt"* ]]; } || [[ "$out" == *$'\n'"not the pinned version:"* ]] ||
    { [ -n "${absent:-}" ] && [[ "$out" == *"$absent"* ]]; }; then
    echo "tasks:test: $case: setup exited $code, wanted $want and '${text:-no note on Qt}'${absent:+ and no '$absent'}; it said:" >&2
    printf '%s\n' "$out" | sed 's/^/    /' >&2
    failed=1
  else
    echo "ok: $case"
  fi
}

for c in newer pinned installer env-newer qt5 qml-newer linked unknown lint-only bare qt5-lint missing gone builtin full; do
  stub "$c" rustup ""
  stub "$c" rustc "rustc 1.98.1 (stand-in)"
done
installer qt-pinned "$qt_pinned.2"
installer qt-newer "$newer.1"
pinned_env=(QMLTESTRUNNER="$scratch/qt-pinned/qmltestrunner" QMLLINT="$scratch/qt-pinned/qmllint")

distro newer "$newer.1"
# Another minor is a legitimate setup: a note naming the Qt found, the pin
# and how to install it, and setup passes.
expect newer 0 "note, a Qt other than the pinned one"
expect newer 0 "qmltestrunner: Qt $newer.1 found ($scratch/newer/qmltestrunner6)"
expect newer 0 "qmllint: Qt $newer.1 found ($scratch/newer/qmllint6)"
expect newer 0 "pinned: Qt $qt_pinned (qt_pinned in mise-tasks/_lib/common.sh"
expect newer 0 "for the pinned Qt: install Qt $qt_pinned (Qt's online installer, or aqt install-qt) and set QMLTESTRUNNER to its qmltestrunner"
distro pinned "$qt_pinned.2"
expect pinned 0 ""
# A newer distribution Qt on PATH, and the pinned installer's tools named,
# with its qml first on PATH as qml6: what the tests run is pinned.
distro installer "$newer.0"
ln -sf "$scratch/qt-pinned/qml" "$scratch/installer/qml6"
expect installer 0 "" "${pinned_env[@]}"
# A pinned distribution Qt, but QMLTESTRUNNER names a newer one.
distro env-newer "$qt_pinned.2"
expect env-newer 0 "qmltestrunner: Qt $newer.1 found ($scratch/qt-newer/qmltestrunner)" \
  QMLTESTRUNNER="$scratch/qt-newer/qmltestrunner"
# Qt 5's qtpaths beside the runner answers 5.15, which is no Qt 6: setup
# cannot tell it is the pinned one, so it says so in a note.
stub qt5-bin qtpaths "5.15.19"
stub qt5-bin qmltestrunner ""
stub qt5-bin qmllint "qmllint 5.15.19"
expect qt5 0 "qmltestrunner: no Qt 6 version answered ($scratch/qt5-bin/qmltestrunner)" \
  QMLTESTRUNNER="$scratch/qt5-bin/qmltestrunner" QMLLINT="$scratch/qt5-bin/qmllint"
# A link on PATH to a newer installer's runner: its Qt is the one the link
# names, though nothing sits beside the link.
ln -s ../qt-newer/qmltestrunner "$scratch/linked/qmltestrunner6"
ln -s "$scratch/qt-pinned/qmllint" "$scratch/linked/qmllint6"
ln -s "$scratch/qt-pinned/qml" "$scratch/linked/qml6"
expect linked 0 "qmltestrunner: Qt $newer.1 found ($scratch/linked/qmltestrunner6)"
# A runner with nothing beside it that answers is not passed unseen.
stub unknown-runner qmltestrunner6 "Unknown option: '--version'"
ln -s "$scratch/qt-pinned/qmllint" "$scratch/unknown/qmllint6"
ln -s "$scratch/qt-pinned/qml" "$scratch/unknown/qml6"
expect unknown 0 "qmltestrunner: no Qt 6 version answered ($scratch/unknown-runner/qmltestrunner6)" \
  QMLTESTRUNNER="$scratch/unknown-runner/qmltestrunner6"
stub qml-newer qml6 "Qml Runtime $newer.0"
expect qml-newer 0 "qml6: Qt $newer.0 found ($scratch/qml-newer/qml6)" "${pinned_env[@]}"
# A distribution's declarative tools alone: no qtpaths or qmake, but the
# qmllint beside the runner is of its Qt.
stub lint-only qmltestrunner6 "Unknown option: '--version'"
stub lint-only qmllint6 "qmllint $qt_pinned.2"
stub lint-only qml6 "Qml Runtime $qt_pinned.2"
expect lint-only 0 ""
# QMLTESTRUNNER as a bare name: its Qt is the one beside it on PATH.
ln -s "$scratch/qt-newer/qmltestrunner" "$scratch/bare/qmltestrunner"
ln -s "$scratch/qt-pinned/qml" "$scratch/bare/qml6"
expect bare 0 "qmltestrunner: Qt $newer.1 found (qmltestrunner)" \
  QMLTESTRUNNER=qmltestrunner QMLLINT="$scratch/qt-pinned/qmllint"
# A qmllint that says it is Qt 5 is Qt 5, whatever Qt 6 tools are beside it.
stub qt5-lint qmllint "qmllint 5.15.2"
stub qt5-lint qmllint6 "qmllint $qt_pinned.2"
expect qt5-lint 0 "qmllint: Qt 5.15.2 found ($scratch/qt5-lint/qmllint)" \
  QMLTESTRUNNER="$scratch/qt-pinned/qmltestrunner" QMLLINT="$scratch/qt5-lint/qmllint"
# A bare name that is not on PATH is said to be missing, as a Qt that is not
# there at all is: Qt is optional, so that is skipped, not a failure. Nothing
# in the current directory is run in its place.
mkdir -p "$scratch/missing"
ln -s "$scratch/qt-pinned/qml" "$scratch/missing/qml6"
expect missing 0 "
  - qmltestrunner (qmltestrunner-typo) is not on PATH" \
  QMLTESTRUNNER=qmltestrunner-typo QMLLINT="$scratch/qt-pinned/qmllint"
expect missing 0 "Qt 6 (qml6, qmllint, qmltestrunner) not all found: QMLTESTRUNNER names no qmltestrunner (below); install" \
  QMLTESTRUNNER=qmltestrunner-typo QMLLINT="$scratch/qt-pinned/qmllint"
# mise run test takes a QMLTESTRUNNER as asked and fails on it, so setup says so.
expect missing 0 "and QMLTESTRUNNER names it, so mise run test fails on it: point QMLTESTRUNNER at Qt $qt_pinned's qmltestrunner, or unset it" \
  QMLTESTRUNNER=qmltestrunner-typo QMLLINT="$scratch/qt-pinned/qmllint"
# A newline in the name is shown as \n, so it cannot start a record of its own.
expect missing 0 "qmltestrunner (qmltestrunner-typo\nsecond) is not on PATH" \
  QMLTESTRUNNER="qmltestrunner-typo
second" QMLLINT="$scratch/qt-pinned/qmllint"
absent="note, a Qt" expect missing 0 "qmltestrunner (typo\nNOTE qml6: Qt 9.0 found) is not on PATH" \
  QMLTESTRUNNER="typo
NOTE qml6: Qt 9.0 found" QMLLINT="$scratch/qt-pinned/qmllint"
# A path that names nothing is missing too, though a Qt answers beside it.
stub gone qmake6 "$newer.1"
ln -s "$scratch/qt-pinned/qml" "$scratch/gone/qml6"
expect gone 0 "qmllint ($scratch/gone/qmllint) is not an executable file" \
  QMLTESTRUNNER="$scratch/qt-pinned/qmltestrunner" QMLLINT="$scratch/gone/qmllint"
# Only what goes without that tool is said: dev does not use qmllint.
expect gone 0 "Qt 6 (qml6, qmllint, qmltestrunner) not all found: QMLLINT names no qmllint (below); install" \
  QMLTESTRUNNER="$scratch/qt-pinned/qmltestrunner" QMLLINT="$scratch/gone/qmllint"
# The QML tests take a set QMLLINT as asked too (crates/eldur_convert/tests/support).
expect gone 0 "so mise run qml:check and mise run test fail on it: point QMLLINT at Qt $qt_pinned's qmllint, or unset it" \
  QMLTESTRUNNER="$scratch/qt-pinned/qmltestrunner" QMLLINT="$scratch/gone/qmllint"
# A shell builtin is no runner, though command -v answers for it.
mkdir -p "$scratch/builtin"
ln -s "$scratch/qt-pinned/qml" "$scratch/builtin/qml6"
expect builtin 0 "qmltestrunner (:) is not on PATH" QMLTESTRUNNER=: QMLLINT="$scratch/qt-pinned/qmllint"
expect builtin 0 "not all found: QMLTESTRUNNER names no qmltestrunner (below)" QMLTESTRUNNER=: QMLLINT="$scratch/qt-pinned/qmllint"
# setup itself, not --check, with another minor: it installs (stand-ins
# here), then says the same note and passes.
distro full "$newer.1"
stub full mise "rustc 1.98.1 (stand-in)"
stub full git ""
expect full 0 "setup done:" usage_check=false usage_offline=true
expect full 0 "qmltestrunner: Qt $newer.1 found ($scratch/full/qmltestrunner6)" usage_check=false usage_offline=true
# What setup needs still fails it: here a rustc that is not the pin.
stub full rustc "rustc 1.0.0 (stand-in)"
expect full 1 "rustc on PATH is 1.0.0" usage_check=false usage_offline=true

[ "$failed" = 0 ] || die "a case above failed"
echo "tasks:test: every case passed"
