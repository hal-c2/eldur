#!/usr/bin/env bash
#MISE description="qmllint every .qml under a directory (default tests/corpus) and load each Main.qml in qml6 off-screen; fail on any warning"
#USAGE arg "[dir]" help="Directory searched for .qml files (default tests/corpus; e.g. the directory mise run corpus prints)"
set -euo pipefail
task_name="qml:check"
# shellcheck source=mise-tasks/_lib/common.sh
. "$(dirname "$0")/../_lib/common.sh"
if [[ -n "${usage_dir:-}" ]]; then
  dir="$(from_caller "$usage_dir")"
else
  dir="$root/tests/corpus"
fi
[[ -d "$dir" ]] || die "no directory at $dir"
qmllint="$(qt6_tool qmllint)"
[[ -n "$qmllint" ]] || die "Qt 6's qmllint not found (set QMLLINT to it): $qt6_install_hint"
command -v qml6 >/dev/null 2>&1 || die "qml6 not found on PATH: $qt6_install_hint"
quit="$root/tools/qml-check/Quit.qml"

status=0
files=0
pages=0
while IFS= read -r -d '' f; do
  files=$((files + 1))
  if ! out=$("$qmllint" "$f" 2>&1) || [[ -n "$out" ]]; then
    echo "qmllint: $f"; echo "$out"; status=1
  fi
done < <(find "$dir" -name '*.qml' -print0)
((files)) || die "no .qml files under $dir"
while IFS= read -r -d '' f; do
  pages=$((pages + 1))
  # A page's console.log and console.info are its own output; console.warn
  # still fails the check. The same environment as `eldur check`: the user's
  # QT_LOGGING_RULES come last and win, and the at-spi bridge, whose warning
  # about an unreachable accessibility bus would fail every page, is off. A
  # desktop platform theme (gtk3) needs a display, so it is dropped too.
  # qml6 has no "load and quit"; Quit.qml, loaded into the same engine, quits
  # after 1 s so warnings during load, the first frames and engine
  # destruction are printed. The timeout catches a page that hangs.
  rc=0
  out=$(cd "$(dirname "$f")" && env -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 QT_LOGGING_RULES="qml.debug=false;qml.info=false${QT_LOGGING_RULES:+;$QT_LOGGING_RULES}" NO_AT_BRIDGE=1 timeout 10 qml6 "$(basename "$f")" "$quit" 2>&1) || rc=$?
  if [[ -n "$out" || $rc -ne 0 ]]; then echo "qml6: $f (exit $rc)"; echo "$out"; status=1; fi
done < <(find "$dir" -name 'Main.qml' -print0)
if ((status)); then
  echo "qml:check: problems above, in $files .qml files and $pages pages under $dir" >&2
else
  echo "qml:check: $files .qml files lint clean and $pages pages load without warnings, under $dir"
fi
exit $status
