#!/usr/bin/env bash
#MISE description="qmllint every .qml under a directory (default tests/corpus) and load each Main.qml in qml6 off-screen; fail on any warning"
set -euo pipefail
dir="${1:-tests/corpus}"
status=0
quit="$(cd "$(dirname "$0")/../.." && pwd)/tools/qml-check/Quit.qml"
while IFS= read -r -d '' f; do
  if ! out=$(qmllint "$f" 2>&1) || [[ -n "$out" ]]; then
    echo "qmllint: $f"; echo "$out"; status=1
  fi
done < <(find "$dir" -name '*.qml' -print0)
while IFS= read -r -d '' f; do
  # A page's console.log and console.info are its own output; console.warn
  # still fails the check. The same environment as `eldur check`: the user's
  # QT_LOGGING_RULES come last and win, and the at-spi bridge, whose warning
  # about an unreachable accessibility bus would fail every page, is off.
  # qml6 has no "load and quit"; Quit.qml, loaded into the same engine, quits
  # after 1 s so warnings during load, the first frames and engine
  # destruction are printed. The timeout catches a page that hangs.
  rc=0
  out=$(cd "$(dirname "$f")" && QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 QT_LOGGING_RULES="qml.debug=false;qml.info=false${QT_LOGGING_RULES:+;$QT_LOGGING_RULES}" NO_AT_BRIDGE=1 timeout 10 qml6 "$(basename "$f")" "$quit" 2>&1) || rc=$?
  if [[ -n "$out" || $rc -ne 0 ]]; then echo "qml6: $f (exit $rc)"; echo "$out"; status=1; fi
done < <(find "$dir" -name 'Main.qml' -print0)
exit $status
